# Reference template for every setting `docker-compose.yml` reads. The installer (`install.sh` /
# `install.ps1`) generates a ready-to-run `.env` from this file (see README.md) — you only need it
# if you want to see the full set of options or hand-roll your own `.env` from scratch.

# Host directory that Postgres data, the upload queue, and logs are bind-mounted from.
# Relative paths resolve against the directory this file lives in. Survives `docker compose down -v`.
LOG_HUB_DATA_DIR=./loghub-db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=a-log

# Session cookie signing secret. Optional: leave it empty and the app generates one on first
# start and keeps it in the database. The installer's generated .env already carries a random one.
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# Behind a reverse proxy: false (default) | true | hop count (e.g. 1) | IP/CIDR list. When enabled it
# overrides COOKIE_SECURE (cookie secure flag follows X-Forwarded-Proto) and fixes the client IP.
TRUST_PROXY=false
# none | password | password-confirm | azure-oauth — see docs/knowledgebase/
# authorization-and-authentificaiton.md. `none` (Mode 1) needs no other config and only accepts
# local callers: localhost, plus — because the app runs in a container — the container's own default
# gateway, which is the address host traffic to the published port arrives from. A good default for
# a single local user, because the real boundary is this compose file's `127.0.0.1`-only port
# binding, NOT the Mode 1 check: with Docker's userland proxy every inbound connection looks like it
# came from the gateway, so changing `ports:` to `5003:3000` (or any non-loopback bind) hands Mode 1
# — no password, auto-identify — to every client that can reach the port. Switch to `password`
# BEFORE exposing the app beyond localhost.
AUTH_MODE=none

# --- Optional settings: leave commented out to keep the defaults shown ---

# Externally reachable base URL of this server, used to build the confirm/reset links in emails
# (Modes 2/3). Never derived from the request Host header. In production, emails with links are
# not sent while this is unset — set it on every Mode 2/3 deployment.
#PUBLIC_BASE_URL=https://log-hub.example.com

# Mode 3 sign-up domain allow-list: comma-separated domains (no "@"). Empty = any domain.
#ALLOWED_EMAIL_DOMAINS=example.com,example.org

# Rate limit for the unauthenticated auth endpoints (sign-up, forgot password, resend
# confirmation, reset password), per client IP and per email: POINTS requests per WINDOW_SEC
# seconds; 0 points disables limiting.
#AUTH_RATE_LIMIT_POINTS=5
#AUTH_RATE_LIMIT_WINDOW_SEC=900

# Repository zip import limits: upload size (5 GiB), entry count, total uncompressed size
# (20 GiB) and single-entry size (400 MiB), in bytes.
#IMPORT_MAX_UPLOAD_BYTES=5368709120
#IMPORT_MAX_ENTRIES=20000
#IMPORT_MAX_UNCOMPRESSED_BYTES=21474836480
#IMPORT_MAX_ENTRY_BYTES=419430400
