# Reference template for every setting `docker-compose.yml` reads. The installer (`install.sh` /
# `install.ps1`) generates a ready-to-run `.env` from this file (see the README.md of the release,
# https://github.com/DataArt/artisyn-log-hub/releases) — you only need it if you want to see the
# full set of options or hand-roll your own `.env` from scratch.

# Host directory that Postgres data, the upload queue, and logs are bind-mounted from.
# Relative paths resolve against the directory this file lives in. Survives `docker compose down -v`.
LOG_HUB_DATA_DIR=./loghub-db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=a-log

# Session cookie signing secret. Optional: leave it empty and the app generates one on first
# start and keeps it in the database. The installer's generated .env already carries a random one.
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# Behind a reverse proxy: false (default) | true | hop count (e.g. 1) | IP/CIDR list. When enabled it
# overrides COOKIE_SECURE (cookie secure flag follows X-Forwarded-Proto) and fixes the client IP.
TRUST_PROXY=false
# none | password | password-confirm | azure-oauth | strict-managed — the modes and the settings
# each one needs are listed in INSTALL.md ("Access and authentication"), shipped next to this file:
#   none             — local callers only, no password (Mode 1).
#   password         — self sign-up with email + password (Mode 2). Needs PUBLIC_BASE_URL.
#   password-confirm — self sign-up, account works after the emailed confirmation link (Mode 3).
#                      Needs PUBLIC_BASE_URL, ADMIN_CONTACT_EMAIL, SMTP_HOST, SMTP_PORT, SMTP_FROM.
#   azure-oauth      — sign-in with Azure Entra ID (Mode 4). Needs the AZURE_* settings below.
#   strict-managed   — email + password, NO self sign-up: only an admin creates accounts and each
#                      person gets an emailed set-password link (24 h). Needs PUBLIC_BASE_URL (in any
#                      environment), ADMIN_CONTACT_EMAIL, SMTP_HOST, SMTP_PORT, SMTP_FROM, and a relay
#                      reachable at startup. On the first start ADMIN_CONTACT_EMAIL becomes the admin
#                      and gets a set-password email; if that email cannot be sent the app does not
#                      start. Then: Admin Panel -> Users -> "+ Create user".
# `none` (Mode 1) needs no other config and only accepts
# local callers: localhost, plus — because the app runs in a container — the container's own default
# gateway, which is the address host traffic to the published port arrives from. A good default for
# a single local user, because the real boundary is this compose file's `127.0.0.1`-only port
# binding, NOT the Mode 1 check: with Docker's userland proxy every inbound connection looks like it
# came from the gateway, so changing `ports:` to `5003:3000` (or any non-loopback bind) hands Mode 1
# — no password, auto-identify — to every client that can reach the port. Switch to `password`
# BEFORE exposing the app beyond localhost.
AUTH_MODE=none

# --- Optional settings: leave commented out to keep the defaults shown ---

# Externally reachable base URL of this server, used to build the confirm/reset/set-password links
# in emails (Modes 2/3 and strict-managed). Never derived from the request Host header. In
# production, emails with links are not sent while this is unset — set it on every Mode 2/3
# deployment. strict-managed refuses to start without it, in any environment.
#PUBLIC_BASE_URL=https://log-hub.example.com

# Email-domain allow-list: comma-separated domains (no "@"). Empty = any domain.
# Mode 3: who may sign up. strict-managed: which addresses an admin may create accounts for
# (never applied to the ADMIN_CONTACT_EMAIL account).
#ALLOWED_EMAIL_DOMAINS=example.com,example.org

# Outgoing mail (confirmation, password-reset and set-password emails). `none` and `azure-oauth`
# never use it.
# - password-confirm (Mode 3) and strict-managed: SMTP_HOST, SMTP_PORT and SMTP_FROM are required,
#   and the relay must be reachable at startup — otherwise the app does not start.
# - password (Mode 2): optional. When SMTP_HOST is set, SMTP_PORT and SMTP_FROM are required too; a
#   relay that cannot be reached only logs a warning. When SMTP_HOST is unset, password reset is
#   unavailable and "Forgot password?" on the login page is disabled.
# SMTP_USER/SMTP_PASSWORD are optional (anonymous relay); SMTP_SECURE is optional (unset = false).
# ADMIN_CONTACT_EMAIL is required for password-confirm and strict-managed, optional for password;
# when set it is shown to users in the "email could not be sent" messages. In strict-managed it is
# also the first admin account (created on the first start, emailed a set-password link).
#ADMIN_CONTACT_EMAIL=admin@example.com
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_FROM=no-reply@example.com
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_SECURE=false

# Azure Entra ID sign-in (`AUTH_MODE=azure-oauth`): required in that mode, ignored by the others.
# The values come from your Azure App Registration (single tenant). AZURE_REDIRECT_URI must exactly
# match a redirect URI registered under the registration's *Web* platform (not SPA), and is
# `<the URL users open>/api/auth/callback` — with the default port mapping
# http://localhost:5003/api/auth/callback. Keep AZURE_CLIENT_SECRET out of version control.
#AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_SECRET=
#AZURE_REDIRECT_URI=http://localhost:5003/api/auth/callback
# Optional: space-separated scopes (unset = "openid profile email") and a custom authority URL,
# which must point at the same tenant (unset = https://login.microsoftonline.com/<tenant>/v2.0).
#AZURE_SCOPES=openid profile email
#AZURE_AUTHORITY=

# Rate limit for the unauthenticated auth endpoints (sign-up, forgot password, resend
# confirmation, reset password), per client IP and per email: POINTS requests per WINDOW_SEC
# seconds; 0 points disables limiting. strict-managed adds fixed limits that these do not change:
# 20 "Forgot password?" requests per client IP per hour and 100 create-user / resend-link emails
# per admin per hour, shared by all worker processes.
#AUTH_RATE_LIMIT_POINTS=5
#AUTH_RATE_LIMIT_WINDOW_SEC=900

# Repository zip import limits: upload size (5 GiB), entry count, total uncompressed size
# (20 GiB) and single-entry size (400 MiB), in bytes.
#IMPORT_MAX_UPLOAD_BYTES=5368709120
#IMPORT_MAX_ENTRIES=20000
#IMPORT_MAX_UNCOMPRESSED_BYTES=21474836480
#IMPORT_MAX_ENTRY_BYTES=419430400

# Session data retention: root sessions whose first log is older than SESSION_RETENTION_DAYS are
# deleted for good. The job runs every CHECK_INTERVAL_MS and purges at most PURGE_BATCH_SIZE root
# sessions per run.
#SESSION_RETENTION_DAYS=30
#SESSION_RETENTION_CHECK_INTERVAL_MS=1800000
#SESSION_RETENTION_PURGE_BATCH_SIZE=200

# Server log files (logs/app-*.log, logs/sql-*.log) retention: app logs are kept for
# LOG_RETENTION_DAYS days and SQL logs for SQL_LOG_RETENTION_DAYS days (today included), and all
# of them together are capped at LOG_RETENTION_MAX_MB (oldest deleted first; today's files are
# never deleted). Checked at startup and every LOG_RETENTION_CHECK_INTERVAL_MS. 0 = no limit.
#LOG_RETENTION_DAYS=5
#SQL_LOG_RETENTION_DAYS=3
#LOG_RETENTION_MAX_MB=100
#LOG_RETENTION_CHECK_INTERVAL_MS=3600000

# Session log reads: at most SESSION_LOGS_MAX_CONCURRENT_STREAMS session-log bodies are streamed
# at once per worker process; further requests wait in line until one finishes.
#SESSION_LOGS_MAX_CONCURRENT_STREAMS=2

# Session log part cache: the server keeps a gzip copy of each session-log part it has served in
# a disposable file cache, so repeated reads skip the database. The folder is safe to delete at
# any time (it refills on the next reads) and need not be backed up. Default folder:
# <UPLOAD_QUEUE_DIR>/part-cache. Files not read for TTL_DAYS days are removed, and the whole cache
# is capped at MAX_MB (least recently read files go first); the sweep runs every SWEEP_INTERVAL_MS.
# SESSION_PART_CACHE_ENABLED=false turns the cache off (every read goes to the database).
#SESSION_PART_CACHE_ENABLED=true
#SESSION_PART_CACHE_DIR=upload-queue/part-cache
#SESSION_PART_CACHE_TTL_DAYS=14
#SESSION_PART_CACHE_MAX_MB=1024
#SESSION_PART_CACHE_SWEEP_INTERVAL_MS=10800000

# Background rebuilds under load: below REBUILD_SLOWDOWN_CPU_PERCENT CPU they run at once; up to
# REBUILD_PAUSE_CPU_PERCENT each step waits up to REBUILD_MAX_DELAY_MS; at or above it they pause,
# but run anyway after REBUILD_HARD_CAP_MS. CPU is sampled every REBUILD_LOAD_SAMPLE_MS (a
# container's CPU quota is taken into account).
#REBUILD_SLOWDOWN_CPU_PERCENT=60
#REBUILD_PAUSE_CPU_PERCENT=99
#REBUILD_HARD_CAP_MS=300000
#REBUILD_MAX_DELAY_MS=10000
#REBUILD_LOAD_SAMPLE_MS=2000

# Background session-log jobs (gzip copies, workflows backfill, re-extraction, cleanup of data
# that arrived for deleted sessions) run at startup and every *_INTERVAL_MS.
#LOG_BODY_GZ_INTERVAL_MS=15000
#WORKFLOWS_BACKFILL_INTERVAL_MS=15000
#SESSION_REEXTRACT_INTERVAL_MS=15000
#DELETED_SESSION_CLEANUP_INTERVAL_MS=60000

# Budget threshold job: every BUDGET_CHECK_INTERVAL_MS (5 minutes) it recomputes each budget's
# current-period spend and raises in-app notices (and emails, when SMTP is set) for newly crossed
# thresholds. BUDGET_CHECK_ENABLED=false turns the job off; budgets and the Spend tab still work.
#BUDGET_CHECK_INTERVAL_MS=300000
#BUDGET_CHECK_ENABLED=true

# Outbound requests: the latest Claude Code version from the public npm registry, model prices
# from the public Anthropic pricing page, and the latest Log Hub release from api.github.com (shown
# to admins as a "new release" badge; at most one call a day). The app checks every INTERVAL_MS and
# fetches when the last result is older than a day. Set *_ENABLED=false on an air-gapped host.
#AI_TOOL_VERSION_CHECK_ENABLED=true
#AI_TOOL_VERSION_CHECK_INTERVAL_MS=3600000
#MODEL_PRICING_FETCH_ENABLED=true
#MODEL_PRICING_FETCH_INTERVAL_MS=3600000
#LOG_HUB_RELEASE_CHECK_ENABLED=true

# Password strength for AUTH_MODE=password / password-confirm / strict-managed: any | mid | long.
#PASSWORD_POLICY=long

# Largest hook upload the app accepts, in MiB, and how many times a queued upload is retried.
#LOGS_MAX_BODY_MB=2500
#UPLOAD_QUEUE_MAX_ATTEMPTS=5

# Every variable in this file reaches the app container (docker-compose.yml loads it with
# `env_file: .env`), so other server settings can be added here the same way. Do not set PORT,
# CLUSTER_MODE, DATABASE_URL or UPLOAD_QUEUE_DIR here: the image and docker-compose.yml own them.
