# DB connection properties...
DATABASE_URL=postgresql://localhost:5432/artisyn_logs
DB_USER=postgres
DB_PASSWORD=change-me

SESSION_SECRET=<random string>
COOKIE_SECURE=true
# Behind a reverse proxy: false (default) | true | hop count (e.g. 1) | IP/CIDR list. When enabled it
# overrides COOKIE_SECURE (cookie secure flag follows X-Forwarded-Proto) and fixes the client IP.
TRUST_PROXY=false
ENV_NAME=local

# Externally reachable base URL of this server (no trailing slash needed), used to build the
# confirm/reset links in emails (Modes 2/3). Never derived from the request Host header.
# Unset: http://localhost:5173 outside production; in production the email is not sent and a
# warning is logged — so set it on every Mode 2/3 deployment.
#PUBLIC_BASE_URL=https://log-hub.example.com

# Cluster launch mode — supplied by the runtime Docker image, not meant to be set by hand.
# When set to `primary`, the process becomes the cluster primary and forks one HTTP worker
# per instance slot; unset (the local dev default) boots a single in-process server.
#CLUSTER_MODE=primary

# Async log upload queue (POST /api/v2/logs)
UPLOAD_QUEUE_DIR=upload-queue
UPLOAD_QUEUE_INTERVAL_MS=1000
UPLOAD_QUEUE_LEASE_TIMEOUT_MS=180000
# Per-tick wall-clock budget (ms) for draining a burst of pending rows — a tick
# keeps claiming+processing rows until this much time has elapsed, so bursts
# (e.g. many small claude-otel chunks) drain within the same tick instead of
# trickling out at one row per UPLOAD_QUEUE_INTERVAL_MS. At least one row is
# always processed per tick regardless of this value, including 0.
UPLOAD_QUEUE_TICK_BUDGET_MS=500
# Rolling window (ms) for the admin Upload Queue worker throughput/utilisation/latency
# stats block. Default 15 minutes.
UPLOAD_QUEUE_STATS_WINDOW_MS=900000
# How long a worker measurement row is retained (ms) before the scheduler prunes it; also
# the window for the "average speed" block. Default 7 days.
UPLOAD_QUEUE_MEASUREMENT_RETENTION_MS=604800000
# Minimum gap (ms) between measurement-prune DELETEs per process — the scheduler ticks once
# a second in each of 3-15 cluster workers, so the prune is throttled. Default 5 minutes.
UPLOAD_QUEUE_MEASUREMENT_PRUNE_INTERVAL_MS=300000
# A chunked upload stuck in partially_uploaded with no chunk for this long (ms) is treated as
# abandoned: the row and its .chunkN part-files are deleted. Default 24 hours.
UPLOAD_QUEUE_PARTIAL_UPLOAD_TTL_MS=86400000
# Minimum gap (ms) between those expiry sweeps per process. Default 10 minutes.
UPLOAD_QUEUE_PARTIAL_UPLOAD_SWEEP_INTERVAL_MS=600000

# Claude Code release-version check (npm dist-tags). Enabled by default; set to 'false' to
# turn off the outbound npm fetch entirely (e.g. air-gapped installs).
#AI_TOOL_VERSION_CHECK_ENABLED=false
# Scheduler tick (ms) for the version check. Each tick only calls npm when the last
# successful fetch is older than 24 h and no worker attempted within the last hour.
AI_TOOL_VERSION_CHECK_INTERVAL_MS=3600000

# Daily model-pricing fetch from the official Anthropic pricing page (platform.claude.com).
# Enabled by default, also in the local dev watch server - it only changes prices when the page
# really changes. Set to 'false' to turn off the outbound fetch entirely (e.g. air-gapped
# installs, or locally if you do not want dev prices to move). Jest disables it in global-setup.ts.
#MODEL_PRICING_FETCH_ENABLED=false
# Scheduler tick (ms) for the pricing fetch. Each tick only fetches when the last successful
# fetch is older than 24 h and no worker attempted within the last hour.
MODEL_PRICING_FETCH_INTERVAL_MS=3600000

# Stored session costs (session_costs). Pricing changes flag affected rows stale; a sweeper
# recomputes them every SESSION_COST_RECOMPUTE_INTERVAL_MS (default 10000; an unset or
# invalid value falls back to it), and is also woken right after each pricing write.
SESSION_COST_RECOMPUTE_INTERVAL_MS=10000
# 'true' makes a pricing write wait for the recompute before responding (used by the
# contract stand for deterministic reads). Any other value: the recompute runs in the background.
#SESSION_COST_RECOMPUTE_INLINE=true

# Tools/MCP tab (session_tool_usage). Ingest only marks a session tree stale; a background drain
# rebuilds stale trees every TOOL_USAGE_REBUILD_INTERVAL_MS (default 15000) and right after each
# upload, claiming up to TOOL_USAGE_REBUILD_BATCH sessions per pass (default 20). An unset or
# invalid value falls back to the default. The first start after the upgrade backfills every
# existing session through this same drain.
TOOL_USAGE_REBUILD_INTERVAL_MS=15000
TOOL_USAGE_REBUILD_BATCH=20

# Repository zip import limits (bytes unless noted). A value that is not a positive integer
# falls back to the default. An import over a limit is rejected with 400.
# Max uploaded zip size — default 5 GiB.
IMPORT_MAX_UPLOAD_BYTES=5368709120
# Max number of entries in the zip — default 20000.
IMPORT_MAX_ENTRIES=20000
# Max total uncompressed size of all entries — default 20 GiB.
IMPORT_MAX_UNCOMPRESSED_BYTES=21474836480
# Max uncompressed size of a single entry — default 400 MiB (an entry is read into one string).
IMPORT_MAX_ENTRY_BYTES=419430400

# Session retention cleanup
SESSION_RETENTION_DAYS=30
SESSION_RETENTION_CHECK_INTERVAL_MS=1800000
SESSION_RETENTION_PURGE_BATCH_SIZE=200

# Turn-end cost advisor orphan-run cleanup — sweeps turn_end_advisor_runs rows
# whose session never got (or lost) its matching sessions row.
TURN_END_ADVISOR_ORPHAN_CLEANUP_INTERVAL_MS=1800000
TURN_END_ADVISOR_ORPHAN_RETENTION_MS=86400000

# Configurable auth modes — one of: none | password | password-confirm | azure-oauth
# Local dev/CI default is password-confirm (Mode 3), matching the deploy default.
AUTH_MODE=password-confirm
# Password strength for Mode 2/3 — one of: any | mid | long (default long if unset)
PASSWORD_POLICY=long
# Required when AUTH_MODE=password-confirm (Mode 3), optional under Mode 2 (password). Shown to
# end users in the "email could not be sent" messages when set. Modes 1/4 never use it.
ADMIN_CONTACT_EMAIL=
# Mode 3 sign-up domain allow-list: comma-separated domains (no "@"), case-insensitive.
# Unset or empty = any domain may sign up.
#ALLOWED_EMAIL_DOMAINS=example.com,example.org

# Rate limit for the unauthenticated auth endpoints (sign-up, forgot password, resend
# confirmation, reset password), counted per client IP and per email address.
# AUTH_RATE_LIMIT_POINTS requests per AUTH_RATE_LIMIT_WINDOW_SEC seconds; 0 disables limiting.
# The counters live in memory per cluster worker, so with N workers the effective limit is
# about N x AUTH_RATE_LIMIT_POINTS.
AUTH_RATE_LIMIT_POINTS=5
AUTH_RATE_LIMIT_WINDOW_SEC=900

# Outgoing mail for confirmation/password-reset emails. No code-level default exists for any of
# these. Modes 1/4 (none, azure-oauth) never use SMTP.
# - Mode 3 (password-confirm): SMTP_HOST/SMTP_PORT/SMTP_FROM are required and the relay must be
#   reachable at startup, otherwise the app does not start.
# - Mode 2 (password): optional. When SMTP_HOST is set, SMTP_PORT/SMTP_FROM are required and a
#   relay that cannot be reached only logs a warning. When SMTP_HOST is unset, password reset is
#   unavailable and "Forgot password?" is disabled.
# SMTP_USER/SMTP_PASSWORD are optional; SMTP_SECURE is optional (unset = false).
# The dev default below points at a local Mailpit (localhost:1025). With the Mode 3 default above
# the dev server does not start unless Mailpit is running, e.g.
# `docker compose -f tests/scenarios/docker-compose.yml up -d`.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Azure Entra ID (Mode 4 — azure-oauth). Real values only in a gitignored server/.env.local, never here.
# Single-tenant only: AZURE_TENANT_ID must be your tenant GUID. Multi-tenant values (common,
# organizations, consumers or a domain name) are rejected at startup, and sign-ins whose token
# `tid` is not this tenant are refused. AZURE_AUTHORITY, if set, must point at the same tenant GUID.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
# Optional — defaults derived from AZURE_TENANT_ID / "openid profile email" when unset.
AZURE_AUTHORITY=
AZURE_SCOPES=
