{
  "name": "artisyn-log-server",
  "version": "0.0.13",
  "description": "Artisyn Log Hub server: log ingestion API, authentication, analytics queries and scheduled jobs",
  "author": "Denis Tsyplakov",
  "license": "MIT",
  "private": true,
  "scripts": {
    "perf": "tsc --project perf-tests/tsconfig.json && node perf-tests/dist/run.js",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node ../scripts/build-hooks-installer.js && nest start",
    "start:dev": "node ../scripts/build-hooks-installer.js && nest start --watch",
    "start:debug": "node ../scripts/build-hooks-installer.js && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --cache --cache-location ../tmp/.eslintcache-server",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile ../tmp/.tsbuildinfo-server",
    "test": "jest --runInBand",
    "test:contract": "jest -c jest.contract.config.js --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "migrate:reset": "ts-node -r tsconfig-paths/register src/database/migrate.ts --reset",
    "migrations:lock": "node ../scripts/migrations-lock.js",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.0",
    "@loghub/bash-view": "file:../packages/bash-view",
    "@loghub/pricing": "file:../packages/pricing",
    "@loghub/tool-monitor": "file:../packages/tool-monitor",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.0",
    "@nestjs/terminus": "^11.1.1",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.27.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/archiver": "^6.0.4",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "multer": "$multer",
    "drizzle-kit": {
      "esbuild": "^0.28.1"
    },
    "qs": "~6.16.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "[\\\\/]packages[\\\\/][^\\\\/]+[\\\\/]src[\\\\/].+\\.ts$": "<rootDir>/jest-ts-cjs-transform.cjs",
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
