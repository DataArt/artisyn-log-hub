# Artisyn AI Work Hub — env file of deploy/docker-compose.yml. Copy to deploy/.env (gitignored)
# and edit it. Docker Compose reads it twice: to fill ${...} in the compose file, and as the app's
# env_file. Every server variable is described in ../.env.example; the ones that matter here:

# --- Compose ------------------------------------------------------------------------------------

# Host port the web UI is published on: http://localhost:<WORK_HUB_PORT>.
WORK_HUB_PORT=5010
# Password of the bundled Postgres (user and database "workhub"). DATABASE_URL is built from it.
POSTGRES_PASSWORD=change-me
# Host folder with every user's files (workspace repositories and homes), recordings and temp
# files: users/<email>/<workspace>/{repo,home}. Created on first start; back it up.
WORK_HUB_FILES=/srv/workhub
# Only when the Docker Engine sees that folder under another path (Docker Desktop on Windows:
# WORK_HUB_FILES=D:/workhub needs WORK_HUB_FILES_ENGINE=/run/desktop/mnt/host/d/workhub).
#WORK_HUB_FILES_ENGINE=

# --- Server -------------------------------------------------------------------------------------

WORK_HUB_ENV=production
# Signs the session cookie; required in production. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Value of the artisyn.workhub.instance label on every Docker object this server creates. Give
# each Work Hub on one Docker Engine its own value.
#WORK_HUB_INSTANCE=default
# Image for new workspaces. Unset: artisyn-work-hub-default:<server version>, built on first start.
#WORK_HUB_DEFAULT_IMAGE=

# --- Auth (same names and meaning as in Log Hub; see ../.env.example) ---------------------------

# none = identify by email only, allowed for requests from this machine. For a shared install use
# password, password-confirm or azure-oauth.
AUTH_MODE=none
# Plain http on localhost: the cookie must not be Secure-only. Set true (or TRUST_PROXY) behind HTTPS.
COOKIE_SECURE=false
#PASSWORD_POLICY=long
#PUBLIC_BASE_URL=https://work-hub.example.com
#TRUST_PROXY=false
#ADMIN_CONTACT_EMAIL=
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_FROM=
#AZURE_TENANT_ID=
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=
#AZURE_REDIRECT_URI=
