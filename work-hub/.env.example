# Artisyn AI Work Hub configuration. Copy to work-hub/.env (gitignored); real environment
# variables win over this file. Commented-out lines show the default used when the variable is unset.

# --- Server -------------------------------------------------------------------------------------

# HTTP port.
#PORT=3100
# Bind address.
#HOST=0.0.0.0
# Postgres URL (required). Work Hub's own database (create it once: CREATE DATABASE workhub).
DATABASE_URL=postgresql://workhub:change-me@localhost:5432/workhub
# Schema created if missing and set as search_path on every connection.
#WORK_HUB_DB_SCHEMA=work_hub
# production | development | test (the role NODE_ENV plays in Log Hub; test skips the auth startup check).
WORK_HUB_ENV=development
# Every user's files live here as plain folders (users/<email>/<workspace>/{repo,home}), next to
# recordings (recordings/) and temp files (tmp/). They stay readable when Work Hub or Docker is
# down: back this folder up.
#WORK_HUB_DATA_DIR=./data
# The same folder as the Docker Engine sees it (workspace volumes bind to it). Unset: the absolute
# WORK_HUB_DATA_DIR; on Windows D:\x becomes Docker Desktop's /run/desktop/mnt/host/d/x.
#WORK_HUB_DOCKER_DATA_DIR=
# Docker Engine endpoint. Unset: the platform default (unix socket, or the Windows named pipe).
#DOCKER_HOST=
# Image for new workspaces and helper containers. Unset: artisyn-work-hub-default:<server version>.
#WORK_HUB_DEFAULT_IMAGE=
# Value of the artisyn.workhub.instance label; scopes every Docker object this server creates.
#WORK_HUB_INSTANCE=default
# Serve the SPA from this directory instead of the copy embedded in the binary (development only).
#WORK_HUB_STATIC_DIR=
# Signs the session cookie (its SHA-512 is the 64-byte key). Required in production.
SESSION_SECRET=<random string>

# --- Auth (same names and meaning as in Log Hub) ------------------------------------------------

# none | password | password-confirm | azure-oauth. Unset: password.
AUTH_MODE=none
# Password strength for password / password-confirm: any | mid | long. Unset: long.
#PASSWORD_POLICY=long
# Required for password-confirm; shown to users when an email could not be sent.
#ADMIN_CONTACT_EMAIL=
# Requests per window for the unauthenticated auth endpoints, per IP and per email; 0 disables.
#AUTH_RATE_LIMIT_POINTS=5
# Length of that rate-limit window in seconds.
#AUTH_RATE_LIMIT_WINDOW_SEC=900
# password-confirm sign-up allow-list: comma-separated domains without "@". Unset: any domain.
#ALLOWED_EMAIL_DOMAINS=example.com,example.org
# External base URL used in confirm/reset email links; never taken from the request Host header.
#PUBLIC_BASE_URL=https://work-hub.example.com
# Secure flag on the session cookie, as in Log Hub: on unless set to false. Browsers accept it on
# plain http://localhost; set false for any other plain-http address.
#COOKIE_SECURE=true
# Behind a reverse proxy: false | true | hop count | IP/CIDR list. When enabled it overrides COOKIE_SECURE.
#TRUST_PROXY=false

# --- Email (password-confirm requires it; password uses it for reset when SMTP_HOST is set) ----

# SMTP relay host. Unset: no email (password reset unavailable in password mode).
#SMTP_HOST=localhost
# SMTP relay port.
#SMTP_PORT=1025
# Sender address of confirmation and reset emails.
#SMTP_FROM=no-reply@example.com
# Optional SMTP login.
#SMTP_USER=
# Optional SMTP password.
#SMTP_PASSWORD=
# true for implicit TLS. Unset: false.
#SMTP_SECURE=false

# --- Azure Entra ID (azure-oauth; single tenant only) -------------------------------------------

# Your tenant GUID (common / organizations / consumers are rejected).
#AZURE_TENANT_ID=
# App registration client id.
#AZURE_CLIENT_ID=
# App registration client secret.
#AZURE_CLIENT_SECRET=
# Redirect URI registered for the app, ending in /api/auth/callback.
#AZURE_REDIRECT_URI=
# Optional authority URL; must point at the same tenant. Unset: derived from AZURE_TENANT_ID.
#AZURE_AUTHORITY=
# Optional space-separated scopes. Unset: "openid profile email".
#AZURE_SCOPES=
