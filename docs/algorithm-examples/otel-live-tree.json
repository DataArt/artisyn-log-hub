[
  {
    "id": "LT-01",
    "input": {
      "kind": "key",
      "key": "home"
    },
    "expected": {
      "parsed": {
        "type": "home",
        "qualified": false
      },
      "formatted": "home"
    },
    "note": "Rule 1: the literal home key, no suffix."
  },
  {
    "id": "LT-02",
    "input": {
      "kind": "key",
      "key": "team:7"
    },
    "expected": {
      "parsed": {
        "type": "team",
        "teamId": 7,
        "qualified": false
      },
      "formatted": "team:7"
    },
    "note": "Rule 1: team:<teamId>; a team key never carries a placement suffix."
  },
  {
    "id": "LT-03",
    "input": {
      "kind": "key",
      "key": "noteam"
    },
    "expected": {
      "parsed": {
        "type": "noteam",
        "noteam": true,
        "qualified": false
      },
      "formatted": "noteam"
    },
    "note": "Rule 1: the literal No-team key."
  },
  {
    "id": "LT-04",
    "input": {
      "kind": "key",
      "key": "repo:12@7"
    },
    "expected": {
      "parsed": {
        "type": "repo",
        "repoId": 12,
        "teamId": 7,
        "qualified": true
      },
      "formatted": "repo:12@7"
    },
    "note": "Rule 2: suffix after the last @ is team 7, so the key is qualified; formatting gives it back unchanged."
  },
  {
    "id": "LT-05",
    "input": {
      "kind": "key",
      "key": "repo:31@noteam"
    },
    "expected": {
      "parsed": {
        "type": "repo",
        "repoId": 31,
        "noteam": true,
        "qualified": true
      },
      "formatted": "repo:31@noteam"
    },
    "note": "Rule 2: the suffix noteam places the repo under No team."
  },
  {
    "id": "LT-06",
    "input": {
      "kind": "key",
      "key": "session:40"
    },
    "expected": {
      "parsed": {
        "type": "session",
        "rootId": 40,
        "qualified": false
      },
      "formatted": "session:40"
    },
    "note": "Rule 2: no @, so the key is unqualified (resolved to its first placement, rule 12)."
  },
  {
    "id": "LT-07",
    "input": {
      "kind": "key",
      "key": "agent:40:ag-1:x@7"
    },
    "expected": {
      "parsed": {
        "type": "agent",
        "rootId": 40,
        "agentKey": "ag-1:x",
        "teamId": 7,
        "qualified": true
      },
      "formatted": "agent:40:ag-1:x@7"
    },
    "note": "Rule 3: split at the first two ':' only, so the agent id keeps its own ':'; the suffix is split at the last @."
  },
  {
    "id": "LT-08",
    "input": {
      "kind": "key",
      "key": "agent:40:main@noteam"
    },
    "expected": {
      "parsed": {
        "type": "agent",
        "rootId": 40,
        "agentKey": "main",
        "noteam": true,
        "qualified": true
      },
      "formatted": "agent:40:main@noteam"
    },
    "note": "Rule 3: the main thread's agent key is the literal main."
  },
  {
