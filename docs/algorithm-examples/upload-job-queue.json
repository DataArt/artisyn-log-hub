[
  {"id": "UQ-01", "input": {"kind": "buildName", "sessionId": "abc-123", "trigger": "session-end", "now": "2026-11-18T19:33:01.123Z", "pid": 4242, "rand": "a1b2"}, "expected": {"name": "abc-123_20261118T193301123Z_session-end_4242-a1b2.json"}, "note": "Rule 1: sid kept as is (only [A-Za-z0-9-]); ts = 2026 11 18 T 19 33 01 123 Z; then trigger, pid-rand"},
  {"id": "UQ-02", "input": {"kind": "buildName", "sessionId": "1f2e/..x y_z", "trigger": "stop", "now": "2026-11-18T19:33:01.123Z", "pid": 7, "rand": "00ff"}, "expected": {"name": "1f2exyz_20261118T193301123Z_stop_7-00ff.json"}, "note": "Rule 1: '/', '.', ' ' and '_' are removed from the sid -> 1f2exyz"},
  {"id": "UQ-03", "input": {"kind": "buildName", "sessionId": "", "trigger": "stop", "now": "2026-11-18T19:33:01.123Z", "pid": 7, "rand": "00ff"}, "expected": {"name": "nosession_20261118T193301123Z_stop_7-00ff.json"}, "note": "Rule 1: empty sid -> nosession"},
  {"id": "UQ-04", "input": {"kind": "buildName", "sessionId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "trigger": "stop", "now": "2026-11-18T19:33:01.123Z", "pid": 7, "rand": "00ff"}, "expected": {"name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_20261118T193301123Z_stop_7-00ff.json"}, "note": "Rule 1: a 70-char sid is cut to its first 64 chars"},
  {"id": "UQ-05", "input": {"kind": "buildName", "sessionId": "s1", "trigger": "prompt", "now": "2026-11-18T19:33:01.123Z", "pid": 7, "rand": "00ff"}, "expected": {"error": true}, "note": "Rule 1: trigger is only stop or session-end; anything else throws"},

  {"id": "UQ-06", "input": {"kind": "parseName", "name": "abc-123_20261118T193301123Z_session-end_4242-a1b2.json"}, "expected": {"sid": "abc-123", "ts": "20261118T193301123Z", "tsMs": 1795030381123, "trigger": "session-end", "pid": 4242, "rand": "a1b2"}, "note": "Rule 2: matches the regex; tsMs = Date.parse('2026-11-18T19:33:01.123Z') = 1795030381123"},
  {"id": "UQ-07", "input": {"kind": "parseName", "name": ".abc_20261118T193301123Z_stop_7-00ff.json.0a0b.tmp"}, "expected": null, "note": "Rule 2: a temp file of an atomic write is not a job"},
  {"id": "UQ-08", "input": {"kind": "parseName", "name": "abc_20261118T193301123Z_stop_7-00ff.json.claim"}, "expected": null, "note": "Rule 2: a claim file is not a job (the regex is anchored at .json$)"},
  {"id": "UQ-09", "input": {"kind": "parseName", "name": "abc_20261118T193301123Z_stop_7-00FF.json"}, "expected": null, "note": "Rule 2: rand is lowercase hex only"},
  {"id": "UQ-10", "input": {"kind": "parseName", "name": "abc_20261118T193301123Z_prompt_7-00ff.json"}, "expected": null, "note": "Rule 2: unknown trigger"},
  {"id": "UQ-11", "input": {"kind": "parseName", "name": "abc_20261318T193301123Z_stop_7-00ff.json"}, "expected": null, "note": "Rule 2: month 13 matches the digits but is not a real instant (round trip fails)"},
  {"id": "UQ-12", "input": {"kind": "parseName", "name": "abc_20260230T000000000Z_stop_7-00ff.json"}, "expected": null, "note": "Rule 2: Feb 30 rolls over to Mar 2 in Date.parse, so the round trip fails"},
  {"id": "UQ-13", "input": {"kind": "parseName", "name": "a_b_20261118T193301123Z_stop_7-00ff.json"}, "expected": null, "note": "Rule 2: '_' is not a sid char, so 'b' is read where the ts must start"},
  {"id": "UQ-14", "input": {"kind": "parseName", "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_20261118T193301123Z_stop_7-00ff.json"}, "expected": null, "note": "Rule 2: a 65-char sid exceeds {1,64}"},

  {"id": "UQ-15", "input": {"kind": "listOrder", "files": ["cur_20261118T193301123Z_stop_99-ffff.json", "cur_20261118T193301123Z_stop_100-0001.json", "abc_20261118T193301123Z_session-end_5-0000.json", "zzz_20261118T193300999Z_stop_1-0000.json", ".cur_20261118T193301123Z_stop_99-ffff.json.0a0b.tmp", "cur_20261118T193301123Z_stop_99-ffff.json.claim", "notes.txt"]}, "expected": ["zzz_20261118T193300999Z_stop_1-0000.json", "abc_20261118T193301123Z_session-end_5-0000.json", "cur_20261118T193301123Z_stop_100-0001.json", "cur_20261118T193301123Z_stop_99-ffff.json"], "note": "Rule 3: the zzz job has the oldest ts (…300999 < …301123) so it is first despite its sid; the three same-ms jobs order by full name: 'abc' < 'cur', and 'stop_1…' < 'stop_9…' as strings; tmp, claim and notes.txt are skipped"},

  {"id": "UQ-16", "input": {"kind": "heartbeat", "now": 1800000000000, "heartbeat": {"schema": 1, "pid": 10, "ts": 1799999985000, "capabilities": ["shared", "upload-queue-v1"], "uploadContract": 1}}, "expected": {"fresh": true}, "note": "Rule 4: now - ts = 15000 <= HEARTBEAT_STALE_MS 15000; capability and contract present"},
  {"id": "UQ-17", "input": {"kind": "heartbeat", "now": 1800000000000, "heartbeat": {"schema": 1, "pid": 10, "ts": 1799999984999, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"fresh": false}, "note": "Rule 4: now - ts = 15001 > 15000"},
  {"id": "UQ-18", "input": {"kind": "heartbeat", "now": 1800000000000, "heartbeat": {"schema": 1, "pid": 10, "ts": 1800000000000, "capabilities": ["shared", "auth-v1"], "uploadContract": 1}}, "expected": {"fresh": false}, "note": "Rule 4: no upload-queue-v1 capability"},
  {"id": "UQ-19", "input": {"kind": "heartbeat", "now": 1800000000000, "heartbeat": {"schema": 1, "pid": 10, "ts": 1800000000000, "capabilities": ["upload-queue-v1"], "uploadContract": 0}}, "expected": {"fresh": false}, "note": "Rule 4: uploadContract 0 < UPLOAD_CONTRACT 1"},
  {"id": "UQ-20", "input": {"kind": "heartbeat", "now": 1800000000000, "heartbeat": {"schema": 1, "pid": 10, "ts": 1800000000000, "capabilities": ["upload-queue-v1"], "uploadContract": 2}}, "expected": {"fresh": true}, "note": "Rule 4: a newer contract 2 >= 1 still takes this hook's jobs"},
  {"id": "UQ-21", "input": {"kind": "heartbeat", "now": 1800000000000, "heartbeat": null}, "expected": {"fresh": false}, "note": "Rule 4: no heartbeat file"},
  {"id": "UQ-22", "input": {"kind": "heartbeat", "now": 1800000000000, "heartbeat": {"schema": 1, "pid": 10, "ts": "1800000000000", "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"fresh": false}, "note": "Rule 4: ts must be a number, a numeric string is not accepted"},
  {"id": "UQ-23", "input": {"kind": "heartbeat", "now": 1800000000000, "heartbeat": {"schema": 1, "pid": 10, "ts": 1800000005000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"fresh": true}, "note": "Rule 4: a ts 5 s in the future gives now - ts = -5000 <= 15000 (no lower bound)"},

  {"id": "UQ-24", "input": {"kind": "decide", "event": "Stop", "now": 1800000000000, "queueDirUsable": true, "heartbeat": {"ts": 1800000000000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"decision": "queue"}, "note": "Rule 5: fresh heartbeat and usable queue dir -> queue"},
  {"id": "UQ-25", "input": {"kind": "decide", "event": "SessionEnd", "now": 1800000000000, "queueDirUsable": true, "heartbeat": {"ts": 1800000000000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"decision": "queue"}, "note": "Rule 5: same for SessionEnd"},
  {"id": "UQ-26", "input": {"kind": "decide", "event": "SessionEnd", "now": 1800000000000, "queueDirUsable": true, "heartbeat": {"ts": 1799999980000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"decision": "session-end-fallback"}, "note": "Rule 5: heartbeat 20000 ms old (> 15000) -> SessionEnd falls back"},
  {"id": "UQ-27", "input": {"kind": "decide", "event": "Stop", "now": 1800000000000, "queueDirUsable": true, "heartbeat": {"ts": 1799999980000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"decision": "in-process-stop"}, "note": "Rule 5: stale heartbeat -> Stop uploads in process"},
  {"id": "UQ-28", "input": {"kind": "decide", "event": "SessionEnd", "now": 1800000000000, "queueDirUsable": false, "heartbeat": {"ts": 1800000000000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"decision": "session-end-fallback"}, "note": "Rule 5: fresh heartbeat but the queue dir is not usable -> fallback"},
  {"id": "UQ-29", "input": {"kind": "decide", "event": "UserPromptSubmit", "now": 1800000000000, "queueDirUsable": true, "heartbeat": {"ts": 1800000000000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"decision": null}, "note": "Rule 5: an event that never uploads -> null"},
  {"id": "UQ-30", "input": {"kind": "decide", "event": "Stop", "now": 1800000000000, "queueDirUsable": true, "heartbeat": null}, "expected": {"decision": "in-process-stop"}, "note": "Rule 5: no heartbeat -> in-process-stop"},

  {"id": "UQ-31", "input": {"kind": "claimStale", "now": 1800000000000, "alivePids": [10], "claim": null}, "expected": {"stale": true}, "note": "Rule 6: no claim -> stale"},
  {"id": "UQ-32", "input": {"kind": "claimStale", "now": 1800000000000, "alivePids": [10], "claim": {"pid": "10", "startedAt": "2027-01-15T07:59:59.000Z"}}, "expected": {"stale": true}, "note": "Rule 6: pid is not an integer -> unparsable -> stale"},
  {"id": "UQ-33", "input": {"kind": "claimStale", "now": 1800000000000, "alivePids": [10], "claim": {"pid": 10, "startedAt": "garbage"}}, "expected": {"stale": true}, "note": "Rule 6: startedAt is not a date -> stale"},
  {"id": "UQ-34", "input": {"kind": "claimStale", "now": 1800000000000, "alivePids": [], "claim": {"pid": 10, "startedAt": "2027-01-15T07:59:59.000Z"}}, "expected": {"stale": true}, "note": "Rule 6: 1 s old but pid 10 is dead -> stale"},
  {"id": "UQ-35", "input": {"kind": "claimStale", "now": 1800000000000, "alivePids": [10], "claim": {"pid": 10, "startedAt": "2027-01-15T07:45:00.000Z"}}, "expected": {"stale": false}, "note": "Rule 6: live pid, age = 900000 = JOB_RUN_TIMEOUT_MS, not > -> live"},
  {"id": "UQ-36", "input": {"kind": "claimStale", "now": 1800000000000, "alivePids": [10], "claim": {"pid": 10, "startedAt": "2027-01-15T07:44:59.999Z"}}, "expected": {"stale": true}, "note": "Rule 6: live pid, age = 900001 > 900000 -> stale"},
  {"id": "UQ-37", "input": {"kind": "claimStale", "now": 1800000000000, "alivePids": [10], "claim": {"pid": 10, "startedAt": "2027-01-15T07:59:59.000Z"}}, "expected": {"stale": false}, "note": "Rule 6: live pid, 1 s old -> live claim"},

  {"id": "UQ-38", "input": {"kind": "stuck", "name": "s1_20261118T193301123Z_stop_7-00ff.json", "now": 1795030681124, "alivePids": [], "claim": null}, "expected": {"stuck": true}, "note": "Rule 7: now - ts = 1795030681124 - 1795030381123 = 300001 > JOB_STUCK_MS 300000, no claim"},
  {"id": "UQ-39", "input": {"kind": "stuck", "name": "s1_20261118T193301123Z_stop_7-00ff.json", "now": 1795030681123, "alivePids": [], "claim": null}, "expected": {"stuck": false}, "note": "Rule 7: age exactly 300000, not > -> not stuck"},
  {"id": "UQ-40", "input": {"kind": "stuck", "name": "s1_20261118T193301123Z_stop_7-00ff.json", "now": 1795030981123, "alivePids": [10], "claim": {"pid": 10, "startedAt": "2026-11-18T19:43:00.123Z"}}, "expected": {"stuck": false}, "note": "Rule 7: 600000 old but a live claim 1 s old -> being run, not stuck"},
  {"id": "UQ-41", "input": {"kind": "stuck", "name": "s1_20261118T193301123Z_stop_7-00ff.json", "now": 1795030981123, "alivePids": [], "claim": {"pid": 10, "startedAt": "2026-11-18T19:43:00.123Z"}}, "expected": {"stuck": true}, "note": "Rule 7: 600000 old and the claim's pid is dead -> stale claim -> stuck"},
  {"id": "UQ-42", "input": {"kind": "stuck", "name": "not-a-job.json", "now": 1795030981123, "alivePids": [], "claim": null}, "expected": {"stuck": false}, "note": "Rule 7: an unparsable name is never stuck"},

  {"id": "UQ-43", "input": {"kind": "outcome", "result": {"uploaded": 2, "retryableFailures": 0, "permanentFailures": 0, "aborted": false}}, "expected": {"outcome": "done"}, "note": "Rule 8: no failure -> done"},
  {"id": "UQ-44", "input": {"kind": "outcome", "result": {"uploaded": 3, "retryableFailures": 0, "permanentFailures": 0, "aborted": true}}, "expected": {"outcome": "retryable"}, "note": "Rule 8: aborted wins even after uploads"},
  {"id": "UQ-45", "input": {"kind": "outcome", "result": {"uploaded": 0, "retryableFailures": 1, "permanentFailures": 2, "aborted": false}}, "expected": {"outcome": "retryable"}, "note": "Rule 8: one retryable failure beats permanent ones"},
  {"id": "UQ-46", "input": {"kind": "outcome", "result": {"uploaded": 0, "retryableFailures": 0, "permanentFailures": 1, "aborted": false}}, "expected": {"outcome": "permanent"}, "note": "Rule 8: permanent failures and nothing uploaded -> permanent"},
  {"id": "UQ-47", "input": {"kind": "outcome", "result": {"uploaded": 1, "retryableFailures": 0, "permanentFailures": 1, "aborted": false}}, "expected": {"outcome": "done"}, "note": "Rule 8: a partly successful run is done; the rejected file is reported via nonUploadableLogs"},
  {"id": "UQ-48", "input": {"kind": "outcome", "result": {"uploaded": 0, "retryableFailures": 0, "permanentFailures": 0, "aborted": false}}, "expected": {"outcome": "done"}, "note": "Rule 8: nothing to do -> done"},

  {"id": "UQ-49", "input": {"kind": "backoff", "n": 1}, "expected": {"delayMs": 30000}, "note": "Rule 9: 30000 * 2^0"},
  {"id": "UQ-50", "input": {"kind": "backoff", "n": 2}, "expected": {"delayMs": 60000}, "note": "Rule 9: 30000 * 2^1"},
  {"id": "UQ-51", "input": {"kind": "backoff", "n": 5}, "expected": {"delayMs": 480000}, "note": "Rule 9: 30000 * 2^4 = 480000 < 900000"},
  {"id": "UQ-52", "input": {"kind": "backoff", "n": 6}, "expected": {"delayMs": 900000}, "note": "Rule 9: 30000 * 2^5 = 960000, capped at 900000"},
  {"id": "UQ-53", "input": {"kind": "backoff", "n": 0}, "expected": {"delayMs": 30000}, "note": "Rule 9: n below 1 counts as 1"},
  {"id": "UQ-54", "input": {"kind": "backoff", "n": 40}, "expected": {"delayMs": 900000}, "note": "Rule 9: any large n stays at the cap"},

  {"id": "UQ-55", "input": {"kind": "jobExit"}, "expected": {"done": 0, "retryable": 10, "permanent": 11, "busy": 12, "dropped": 13}, "note": "Rule 10: the DD-5 exit code table"},
  {"id": "UQ-56", "input": {"kind": "constants"}, "expected": {"UPLOAD_DIR": "upload", "QUEUE_DIR": "queue", "FAILED_DIR": "failed", "HEARTBEAT_FILE": "heartbeat.json", "UPLOADER_LOCK_FILE": "uploader.lock", "UPLOAD_QUEUE_CAPABILITY": "upload-queue-v1", "UPLOAD_CONTRACT": 1, "JOB_SCHEMA": 1, "HEARTBEAT_STALE_MS": 15000, "JOB_RUN_TIMEOUT_MS": 900000}, "note": "Rule 10: the shared constants both twins must agree on"},

  {"id": "UQ-57", "input": {"kind": "unreachable", "code": "ECONNREFUSED"}, "expected": {"unreachable": true}, "note": "Rule 11: nothing listens on the port"},
  {"id": "UQ-58", "input": {"kind": "unreachable", "code": "ENOTFOUND"}, "expected": {"unreachable": true}, "note": "Rule 11: DNS has no such host"},
  {"id": "UQ-59", "input": {"kind": "unreachable", "code": "EAI_AGAIN"}, "expected": {"unreachable": true}, "note": "Rule 11: DNS temporarily failing (offline)"},
  {"id": "UQ-60", "input": {"kind": "unreachable", "code": "EHOSTUNREACH"}, "expected": {"unreachable": true}, "note": "Rule 11: no route to host"},
  {"id": "UQ-61", "input": {"kind": "unreachable", "code": "ENETUNREACH"}, "expected": {"unreachable": true}, "note": "Rule 11: no network"},
  {"id": "UQ-62", "input": {"kind": "unreachable", "code": "ECONNTIMEOUT"}, "expected": {"unreachable": true}, "note": "Rule 11: the 3 s connect timer fired"},
  {"id": "UQ-63", "input": {"kind": "unreachable", "code": "ECONNRESET"}, "expected": {"unreachable": false}, "note": "Rule 11: a reset after connecting is a per-file failure, not 'no connection'"},
  {"id": "UQ-64", "input": {"kind": "unreachable", "code": "ETIMEDOUT"}, "expected": {"unreachable": false}, "note": "Rule 11: not in the list (the response timeout stays per request)"},
  {"id": "UQ-65", "input": {"kind": "unreachable", "code": null}, "expected": {"unreachable": false}, "note": "Rule 11: no code (e.g. an HTTP 500) -> not unreachable"},

  {"id": "UQ-66", "input": {"kind": "decide", "event": "Stop", "now": 1800000000000, "queueDirUsable": false, "heartbeat": {"ts": 1800000000000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"decision": "in-process-stop"}, "note": "Rule 5: fresh heartbeat but the queue dir is not usable -> Stop uploads in process"},
  {"id": "UQ-67", "input": {"kind": "decide", "event": "Stop", "now": 1800000000000, "queueDirUsable": true, "heartbeat": {"ts": 1799999985000, "capabilities": ["upload-queue-v1"], "uploadContract": 1}}, "expected": {"decision": "queue"}, "note": "Rule 5: heartbeat exactly 15000 ms old is still fresh -> Stop queues"},
  {"id": "UQ-68", "input": {"kind": "decide", "event": "Stop", "now": 1800000000000, "queueDirUsable": true, "heartbeat": {"ts": 1800000000000, "capabilities": ["shared", "auth-v1"], "uploadContract": 1}}, "expected": {"decision": "in-process-stop"}, "note": "Rule 5: a receiver without upload-queue-v1 (pre-3.0.0) never gets a stop job"},

  {"id": "UQ-69", "input": {"kind": "backoff", "n": 3}, "expected": {"delayMs": 120000}, "note": "Rule 9: 30000 * 2^2"},
  {"id": "UQ-70", "input": {"kind": "backoff", "n": 4}, "expected": {"delayMs": 240000}, "note": "Rule 9: 30000 * 2^3"},
  {"id": "UQ-71", "input": {"kind": "backoff", "n": 7}, "expected": {"delayMs": 900000}, "note": "Rule 9: 30000 * 2^6 = 1920000, capped at 900000"},

  {"id": "UQ-72", "input": {"kind": "limit", "now": 1800000000000, "createdAt": "2027-01-15T07:59:00.000Z", "attempts": 0}, "expected": {"reason": null}, "note": "Rule 12: one minute old, no attempts -> runnable"},
  {"id": "UQ-73", "input": {"kind": "limit", "now": 1800000000000, "createdAt": "2027-01-14T08:00:00.000Z", "attempts": 9}, "expected": {"reason": null}, "note": "Rule 12: age exactly 86400000 = JOB_MAX_AGE_MS, not >; 9 < JOB_MAX_ATTEMPTS 10 -> runnable"},
  {"id": "UQ-74", "input": {"kind": "limit", "now": 1800000000000, "createdAt": "2027-01-14T07:59:59.999Z", "attempts": 0}, "expected": {"reason": "over-age"}, "note": "Rule 12: age 86400001 > 24 h -> over-age"},
  {"id": "UQ-75", "input": {"kind": "limit", "now": 1800000000000, "createdAt": "2027-01-14T07:00:00.000Z", "attempts": 0}, "expected": {"reason": "over-age"}, "note": "Rule 12: 25 h old (the s-hook-01 failed/ step) -> over-age"},
  {"id": "UQ-76", "input": {"kind": "limit", "now": 1800000000000, "createdAt": "2027-01-15T07:59:00.000Z", "attempts": 10}, "expected": {"reason": "max-attempts"}, "note": "Rule 12: attempts 10 >= JOB_MAX_ATTEMPTS 10 -> max-attempts"},
  {"id": "UQ-77", "input": {"kind": "limit", "now": 1800000000000, "createdAt": "2027-01-13T08:00:00.000Z", "attempts": 12}, "expected": {"reason": "over-age"}, "note": "Rule 12: both limits hit -> over-age is checked first"},

  {"id": "UQ-78", "input": {"kind": "requeueable", "reason": "over-age"}, "expected": {"requeueable": true}, "note": "Rule 13: the job only ran out of time (24 h), the data was never refused"},
  {"id": "UQ-79", "input": {"kind": "requeueable", "reason": "max-attempts"}, "expected": {"requeueable": true}, "note": "Rule 13: 10 retryable runs (e.g. no VPN) -> retry once the server is reachable"},
  {"id": "UQ-80", "input": {"kind": "requeueable", "reason": "uploader-crash"}, "expected": {"requeueable": true}, "note": "Rule 13: JOB_MAX_CRASHES uploader crashes -> retried (a fixed hook may run it)"},
  {"id": "UQ-81", "input": {"kind": "requeueable", "reason": "upload-rejected"}, "expected": {"requeueable": false}, "note": "Rule 13: a 4xx would be refused again -> never re-queued (no endless loop)"},
  {"id": "UQ-82", "input": {"kind": "requeueable", "reason": "invalid-json"}, "expected": {"requeueable": false}, "note": "Rule 13: an unparsable job cannot be rebuilt"},
  {"id": "UQ-83", "input": {"kind": "requeueable", "reason": "uploader-not-allowed"}, "expected": {"requeueable": false}, "note": "Rule 13: a refused uploader path stays refused"},
  {"id": "UQ-84", "input": {"kind": "requeueable", "reason": "uploader-too-old"}, "expected": {"requeueable": false}, "note": "Rule 13: the uploader version would be refused again"},
  {"id": "UQ-85", "input": {"kind": "requeueable", "reason": "uploader-version-unknown"}, "expected": {"requeueable": false}, "note": "Rule 13: no readable version.json -> stays failed"},
  {"id": "UQ-86", "input": {"kind": "requeueable", "reason": "Over-Age"}, "expected": {"requeueable": false}, "note": "Rule 13: exact, case-sensitive match only"},
  {"id": "UQ-87", "input": {"kind": "requeueable", "reason": null}, "expected": {"requeueable": false}, "note": "Rule 13: a record without failedReason is not eligible"},
  {"id": "UQ-88", "input": {"kind": "buildName", "sessionId": "x", "trigger": "stop", "now": "2026-12-31T23:59:59.999Z", "pid": 0, "rand": "ffff"}, "expected": {"name": "x_20261231T235959999Z_stop_0-ffff.json"}, "note": "Rule 1: year-end instant keeps all 19 ts chars; pid 0 is a valid integer and is kept"}
]
