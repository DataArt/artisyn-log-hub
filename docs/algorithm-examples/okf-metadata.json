[
  {"id": "OM-01", "kind": "versionHint", "input": {}, "expected": {"hint": true},
   "note": "Rule 1: no okf_version -> no version to compare -> hint."},
  {"id": "OM-02", "kind": "versionHint", "input": {"okfVersion": "0.1"}, "expected": {"hint": true},
   "note": "Rule 1: (0, 1) < (0, 3) -> hint."},
  {"id": "OM-03", "kind": "versionHint", "input": {"okfVersion": "0.2"}, "expected": {"hint": true},
   "note": "Rule 1: (0, 2) < (0, 3) -> hint."},
  {"id": "OM-04", "kind": "versionHint", "input": {"okfVersion": "0.3"}, "expected": {"hint": false},
   "note": "Rule 1: (0, 3) is the current version -> no hint."},
  {"id": "OM-05", "kind": "versionHint", "input": {"okfVersion": "\"0.3\""}, "expected": {"hint": false},
   "note": "Rule 1: one pair of quotes is stripped -> 0.3 -> no hint."},
  {"id": "OM-06", "kind": "versionHint", "input": {"okfVersion": "0.3.1"}, "expected": {"hint": false},
   "note": "Rule 1: the patch part is allowed and ignored -> (0, 3) -> no hint."},
  {"id": "OM-07", "kind": "versionHint", "input": {"okfVersion": "0.10"}, "expected": {"hint": false},
   "note": "Rule 1: numeric, not lexical: minor 10 > 3 -> no hint."},
  {"id": "OM-08", "kind": "versionHint", "input": {"okfVersion": "1"}, "expected": {"hint": true},
   "note": "Rule 1: no '.minor' -> does not match major.minor[.patch] -> hint."},
  {"id": "OM-09", "kind": "versionHint", "input": {"okfVersion": "1.0"}, "expected": {"hint": false},
   "note": "Rule 1: major 1 > 0 -> newer than 0.3 -> no hint."},
  {"id": "OM-10", "kind": "versionHint", "input": {"okfVersion": "foo"}, "expected": {"hint": true},
   "note": "Rule 1: not a version -> hint."},

  {"id": "OM-11", "kind": "staleAfter", "input": {"value": "2026-03-01"}, "expected": {"ms": 1772323200000},
   "note": "Rule 2: date only -> 00:00 UTC of that day: 1970..2025 = 56 years with 14 leap days = 20 454 days, + 31 (Jan) + 28 (Feb) = 20 513 days x 86 400 000 = 1 772 323 200 000."},
  {"id": "OM-12", "kind": "staleAfter", "input": {"value": "2026-03-01T10:00:00Z"}, "expected": {"ms": 1772359200000},
   "note": "Rule 2: date-time with Z -> OM-11 + 10 h (36 000 000) = 1 772 359 200 000."},
  {"id": "OM-13", "kind": "staleAfter", "input": {"value": "2026-03-01T10:00:00+02:00"}, "expected": {"ms": 1772352000000},
   "note": "Rule 2: +02:00 -> 08:00 UTC -> OM-11 + 8 h (28 800 000) = 1 772 352 000 000."},
  {"id": "OM-14", "kind": "staleAfter", "input": {"value": "2026-03-01T10:00:00.500Z"}, "expected": {"ms": 1772359200500},
   "note": "Rule 2: fractional seconds allowed -> OM-12 + 500 ms."},
  {"id": "OM-15", "kind": "staleAfter", "input": {"value": "next spring"}, "expected": {"ms": null},
   "note": "Rule 2: free text matches neither format -> null."},
  {"id": "OM-16", "kind": "staleAfter", "input": {"value": "2026-02-30"}, "expected": {"ms": null},
   "note": "Rule 2: the date-only shape matches but February 30 does not exist -> null (no roll-over to March 2)."},
  {"id": "OM-17", "kind": "staleAfter", "input": {"value": "2026-03-01T10:00:00"}, "expected": {"ms": null},
   "note": "Rule 2: a date-time without Z or an offset is ambiguous -> null."},

  {"id": "OM-18", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide", "staleAfter": "2026-03-01"}}},
   "expected": {"deprecated": false, "supersededBy": null, "pastStaleAfter": true, "formatHints": []},
   "note": "Rule 4: stale_after 2026-03-01 (1 772 323 200 000) < refMs 2026-06-01 (1 780 272 000 000) -> past. Rule 5: front matter with type, generated -> no hints."},
  {"id": "OM-19", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide", "staleAfter": "2027-01-01"}}},
   "expected": {"deprecated": false, "supersededBy": null, "pastStaleAfter": false, "formatHints": []},
   "note": "Rule 4: 2027-01-01 is after the reference time -> not past."},
  {"id": "OM-20", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide", "staleAfter": "soon"}}},
   "expected": {"deprecated": false, "supersededBy": null, "pastStaleAfter": true, "formatHints": []},
   "note": "Rule 4: an unparseable stale_after counts as past (the author asked for a re-check and we cannot tell when)."},
  {"id": "OM-21", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/sub/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide", "status": "DePrecated", "supersededBy": "b.md"}}},
   "expected": {"deprecated": true, "supersededBy": "kb/sub/b.md", "pastStaleAfter": false, "formatHints": []},
   "note": "Rule 3: status lower-cased is 'deprecated' -> deprecated. Rule 6: b.md is relative to the article folder kb/sub -> kb/sub/b.md. No stale_after -> not past."},
  {"id": "OM-22", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/sub/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide", "status": "deprecated", "supersededBy": "/x/y.md"}}},
   "expected": {"deprecated": true, "supersededBy": "kb/x/y.md", "pastStaleAfter": false, "formatHints": []},
   "note": "Rule 6: a leading / means the bundle root kb -> kb/x/y.md (not the repo root)."},
  {"id": "OM-23", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/sub/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide", "status": "deprecated", "supersededBy": "../c.md"}}},
   "expected": {"deprecated": true, "supersededBy": "kb/c.md", "pastStaleAfter": false, "formatHints": []},
   "note": "Rule 6: kb/sub + ../c.md collapses to kb/c.md."},
  {"id": "OM-24", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/sub/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide", "status": "deprecated", "supersededBy": "../../../z.md"}}},
   "expected": {"deprecated": true, "supersededBy": "../../../z.md", "pastStaleAfter": false, "formatHints": []},
   "note": "Rule 6: kb/sub + ../../../z.md pops kb, sub and then an empty stack -> escapes the repo -> the raw value is kept."},
  {"id": "OM-25", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide", "status": "active", "supersededBy": "b.md"}}},
   "expected": {"deprecated": false, "supersededBy": null, "pastStaleAfter": false, "formatHints": []},
   "note": "Rule 3: status active -> not deprecated, so superseded_by is neither resolved nor emitted -> null."},
  {"id": "OM-26", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/a.md", "meta": {"frontMatter": false, "hasGenerated": false, "hasTimestamp": false}}},
   "expected": {"deprecated": false, "supersededBy": null, "pastStaleAfter": false, "formatHints": ["no_front_matter"]},
   "note": "Rule 5: no front matter -> no_front_matter only; no_type needs front matter, so it is not added on top."},
  {"id": "OM-27", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/a.md", "meta": {"frontMatter": true, "hasGenerated": false, "hasTimestamp": true}}},
   "expected": {"deprecated": false, "supersededBy": null, "pastStaleAfter": false, "formatHints": ["no_type", "v01_timestamp"]},
   "note": "Rule 5: front matter without type -> no_type; timestamp without generated -> v01_timestamp; in that order."},
  {"id": "OM-28", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": true, "type": "Guide"}}},
   "expected": {"deprecated": false, "supersededBy": null, "pastStaleAfter": false, "formatHints": []},
   "note": "Rule 5: timestamp together with generated is not the v0.1 form -> no hint."},
  {"id": "OM-29", "kind": "flags",
   "input": {"refMs": 1780272000000, "file": {"path": "kb/a.md"}},
   "expected": {"deprecated": false, "supersededBy": null, "pastStaleAfter": false, "formatHints": []},
   "note": "Rule 3: no meta (a hook older than 3.1.0) -> every flag false, no hints."},

  {"id": "OM-30", "kind": "summary",
   "input": {"refMs": 1780272000000, "bundle": {"okfVersion": "0.2", "title": "KB", "files": [
     {"path": "kb/index.md"}, {"path": "kb/a.md"}]}},
   "expected": null,
   "note": "Rule 7: no file carries meta -> the bundle came from an old hook -> null (FR-9), even though okfVersion and title are set."},
  {"id": "OM-31", "kind": "summary",
   "input": {"refMs": 1780272000000, "bundle": {"okfVersion": "0.2", "title": "KB", "files": [
     {"path": "kb/index.md", "meta": {"frontMatter": true, "hasGenerated": false, "hasTimestamp": false}},
     {"path": "kb/log.md", "meta": {"frontMatter": false, "hasGenerated": false, "hasTimestamp": false}},
     {"path": "kb/sub/index.md", "meta": {"frontMatter": false, "hasGenerated": false, "hasTimestamp": false}},
     {"path": "kb/.hidden/x.md", "meta": {"frontMatter": false, "hasGenerated": false, "hasTimestamp": false}},
     {"path": "kb/a.md", "meta": {"frontMatter": false, "hasGenerated": false, "hasTimestamp": false}},
     {"path": "kb/b.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide"}},
     {"path": "kb/c.md", "meta": {"frontMatter": true, "hasGenerated": false, "hasTimestamp": true, "type": "Note"}}]}},
   "expected": {"title": "KB", "okfVersion": "0.2", "newerFormatHint": true, "articlesWithHints": 2, "hintReasons": ["no_front_matter", "v01_timestamp"]},
   "note": "Rule 7: the articles are a, b, c only (the index, log.md, the nested index.md and the .hidden path are not articles, though all would hint). a -> no_front_matter, b clean, c -> v01_timestamp -> 2 articles, reasons in fixed order. 0.2 < 0.3 -> newerFormatHint. No description -> key absent."},
  {"id": "OM-32", "kind": "summary",
   "input": {"refMs": 1780272000000, "bundle": {"okfVersion": "0.3", "description": "Team KB", "files": [
     {"path": "kb/index.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Index"}},
     {"path": "kb/a.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Guide"}}]}},
   "expected": {"description": "Team KB", "okfVersion": "0.3", "newerFormatHint": false, "articlesWithHints": 0, "hintReasons": []},
   "note": "Rule 7: current version -> no newerFormatHint; the one article is clean -> 0, []. No title -> key absent."},
  {"id": "OM-33", "kind": "summary",
   "input": {"refMs": 1780272000000, "bundle": {"files": [
     {"path": "kb/index.md", "meta": {"frontMatter": true, "hasGenerated": true, "hasTimestamp": false, "type": "Index"}}]}},
   "expected": {"newerFormatHint": true, "articlesWithHints": 0, "hintReasons": []},
   "note": "Rule 7: hook meta present (on the index) but no okf_version -> newerFormatHint (rule 1); no articles -> 0, []; no title / description / okfVersion keys."}
]
