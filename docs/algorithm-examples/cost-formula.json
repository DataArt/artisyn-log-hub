    "input": {"tokens":{"inputTokens":"Infinity","outputTokens":100000},"pricing":{"priceIn":5,"priceOut":25,"priceCacheR":0.5,"priceCacheW5m":6.25,"priceCacheW1h":10,"priceWebSearch":0.01}},
    "expected": {"cost":2.5},
