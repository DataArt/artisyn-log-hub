    "note": "At t = 40: cost 1 (main at 10) + 4 (x at 30) = 5; calls at 10 and 30 = 2 (the call without a timestamp never counts); failed 0 (main's failure is at 50); started: x (20 ≤ 40), not y; elapsed 40 − 0."
  },
  {
    "id": "SMM-24",
    "input": {"op": "counters", "sessionStart": 0, "treeCost": 15, "t": 120,
      "main": {"f": 0, "events": [{"t": 10}, {"t": 50, "failed": true}], "costEvents": [{"t": 10, "cost": 1}, {"t": 50, "cost": 2}]},
      "agents": [
