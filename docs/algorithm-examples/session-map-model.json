    "input": {"op": "group",
      "agents": [
        {"agentId": "e", "parentId": null, "workflowRunId": "R9", "startMs": 200},
        {"agentId": "f", "parentId": null, "workflowRunId": "R8", "startMs": 100},
        {"agentId": "g", "parentId": null, "workflowRunId": "R7", "startMs": 300}
      ],
      "workflows": [
        {"toolUseId": "tu-b", "name": "deploy", "status": "running", "wfId": null},
