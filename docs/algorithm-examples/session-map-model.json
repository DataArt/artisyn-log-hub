  },
  {
    "id": "SMM-23",
    "input": {"op": "counters", "sessionStart": 0, "treeCost": 15, "t": 40,
      "main": {"f": 0, "events": [{"t": 10}, {"t": 50, "failed": true}], "costEvents": [{"t": 10, "cost": 1}, {"t": 50, "cost": 2}]},
      "agents": [
        {"id": "x", "f": 20, "events": [{"t": 30}, {"t": null}], "costEvents": [{"t": 30, "cost": 4}]},
        {"id": "y", "f": 100, "events": [{"t": 120, "failed": true}], "costEvents": [{"t": 120, "cost": 8}]}
      ]},
