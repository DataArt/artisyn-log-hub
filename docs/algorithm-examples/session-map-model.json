        {"agentId": "b", "parentId": null, "workflowRunId": "W1", "startMs": 1500},
        {"agentId": "c", "parentId": null, "workflowRunId": null, "startMs": 1000},
        {"agentId": "d", "parentId": null, "workflowRunId": "W2", "startMs": 1200}
      ],
      "workflows": [
        {"toolUseId": "tu1", "name": "review", "status": "completed", "wfId": "W1"},
        {"toolUseId": "tu2", "name": "build", "status": "completed", "wfId": "W2"}
