  {"id": "VR-13", "input": {"op": "hidden", "name": "MONKEY_NAME"}, "expected": {"hidden": true}, "note": "Rule 1 as written: KEY is a substring of MONKEY. A false positive on the safe side; the user can unmark it."},
  {"id": "VR-14", "input": {"op": "valid", "name": "JIRA_URL"}, "expected": {"valid": true}, "note": "Rule 2: letters and '_'."},
  {"id": "VR-15", "input": {"op": "valid", "name": "_X1"}, "expected": {"valid": true}, "note": "Rule 2: may start with '_', digits after the first character."},
  {"id": "VR-16", "input": {"op": "valid", "name": "1ABC"}, "expected": {"valid": false}, "note": "Rule 2: may not start with a digit."},
  {"id": "VR-17", "input": {"op": "valid", "name": "MY-VAR"}, "expected": {"valid": false}, "note": "Rule 2: '-' is not allowed (sh would not accept it as a name)."},
  {"id": "VR-18", "input": {"op": "valid", "name": ""}, "expected": {"valid": false}, "note": "Rule 2: needs at least one character."},
  {"id": "VR-19", "input": {"op": "valid", "name": "ПЕРЕМЕННАЯ"}, "expected": {"valid": false}, "note": "Rule 2 is ASCII only."},
