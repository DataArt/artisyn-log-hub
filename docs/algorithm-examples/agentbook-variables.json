  {"id": "VR-21", "input": {"op": "credential", "prefix": "AgentBook/", "folder": "f1aaaaaa", "laptop": "k3m7q2xa", "name": "JIRA_PAT"}, "expected": {"target": "AgentBook/f1aaaaaa/k3m7q2xa/JIRA_PAT"}, "note": "Rule 3: Only for one laptop: the laptop id between folder id and name."},
  {"id": "VR-22", "input": {"op": "credential", "prefix": "AgentBook-test-run7/", "folder": "f1aaaaaa", "name": "JIRA_PAT"}, "expected": {"target": "AgentBook-test-run7/f1aaaaaa/JIRA_PAT"}, "note": "Rule 3: the scenario stand's prefix replaces AgentBook/."},
  {"id": "VR-23", "input": {"op": "container-refs", "value": "${containerEnv:PATH}:/opt/tool/bin", "containerEnv": [["PATH", "/usr/bin:/bin"]]}, "expected": {"value": "/usr/bin:/bin:/opt/tool/bin"}, "note": "Rule 4: the reference is replaced by the container's PATH."},
  {"id": "VR-24", "input": {"op": "container-refs", "value": "${containerEnv:MISSING:fallback}", "containerEnv": []}, "expected": {"value": "fallback"}, "note": "Rule 4: not in the container env: the default after the second ':'."},
  {"id": "VR-25", "input": {"op": "container-refs", "value": "${containerEnv:MISSING}x", "containerEnv": [["OTHER", "1"]]}, "expected": {"value": "x"}, "note": "Rule 4: not found and no default: empty."},
  {"id": "VR-26", "input": {"op": "container-refs", "value": "${localEnv:HOME}/a", "containerEnv": [["HOME", "/root"]]}, "expected": {"value": "${localEnv:HOME}/a"}, "note": "Rule 4 touches only containerEnv references."},
