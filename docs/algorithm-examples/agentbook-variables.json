    "expected": {"vars": [
      {"name": "JIRA_URL", "value": "https://jira.example.com", "source": "project", "editable": true, "needsValue": false},
      {"name": "JIRA_PAT", "value": {"hidden": true}, "source": "folder", "editable": true, "needsValue": false}
    ]},
    "note": "Rule 6: the folder's Hidden value replaces the default in place; a Hidden marker never needs a value (rule 8)."
  },
  {
    "id": "VR-30",
    "input": {"op": "resolve", "defaults": [["JIRA_PAT", ""]], "folder": [{"name": "JIRA_PAT", "hidden": true}], "laptop": [{"name": "JIRA_PAT", "value": "other-pat"}]},
    "expected": {"vars": [
      {"name": "JIRA_PAT", "value": "other-pat", "source": "laptop", "editable": true, "needsValue": false}
    ]},
    "note": "Rule 7: the per-laptop override wins over the folder value, which won over the project default."
  },
  {
