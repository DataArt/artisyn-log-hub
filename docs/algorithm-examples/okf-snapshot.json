[
  {
    "id": "OS-01",
    "kind": "detect",
    "input": {"tree": {
      "docs/kb/index.md": "---\nokf_version: 1\ntitle: KB\n---\n# KB\n",
      "docs/kb/db.md": "# DB\n",
      "docs/kb/sub/api.md": "# API\n",
      "notes/index.md": "---\nokf_version: 1\n---\n",
      "notes/todo.md": "todo\n",
      "README.md": "# readme\n",
      "src/a.ts": "export {};\n"
    }},
    "expected": {
      "bundles": [
        {"root": "docs/kb", "index": "docs/kb/index.md", "files": ["docs/kb/db.md", "docs/kb/index.md", "docs/kb/sub/api.md"]},
        {"root": "notes", "index": "notes/index.md", "files": ["notes/index.md", "notes/todo.md"]}
      ],
      "ignored": [], "ignoredBundles": []
    },
    "note": "Rule 3: both index.md files declare okf_version -> two bundles. Rule 4: sub/api.md belongs to docs/kb; README.md is under no root and a.ts is not .md -> dropped. Rule 5: sorted by root and path ('db' < 'index' < 'sub'). Rule 7: fresh repo, nothing ignored."
  },
  {
    "id": "OS-02",
    "kind": "detect",
    "input": {"tree": {
      "docs/kb/index.md": "---\nokf_version: 1\n---\n",
      "docs/kb/log-schema/index.md": "---\ntitle: Log schema\n---\n",
      "docs/kb/log-schema/lines.md": "x\n"
    }},
    "expected": {
      "bundles": [{"root": "docs/kb", "index": "docs/kb/index.md", "files": ["docs/kb/index.md", "docs/kb/log-schema/index.md", "docs/kb/log-schema/lines.md"]}],
      "ignored": [], "ignoredBundles": []
    },
    "note": "Rule 3: the nested index has front matter but no okf_version -> no bundle of its own. Rule 4: it and lines.md belong to the parent docs/kb."
  },
  {
    "id": "OS-03",
    "kind": "detect",
    "input": {"tree": {
      "docs/kb/index.md": "---\nokf_version: 1\n---\n",
      "docs/kb/a.md": "a\n",
      "docs/kb/api/index.md": "---\nokf_version: 1\n---\n",
      "docs/kb/api/b.md": "b\n"
    }},
    "expected": {
      "bundles": [
        {"root": "docs/kb", "index": "docs/kb/index.md", "files": ["docs/kb/a.md", "docs/kb/index.md"]},
        {"root": "docs/kb/api", "index": "docs/kb/api/index.md", "files": ["docs/kb/api/b.md", "docs/kb/api/index.md"]}
      ],
      "ignored": [], "ignoredBundles": []
    },
    "note": "Rule 3: the nested index declares okf_version -> its own bundle. Rule 4: docs/kb/api/* goes to the deepest root docs/kb/api, not to docs/kb."
  },
  {
    "id": "OS-04",
    "kind": "detect",
    "input": {"tree": {
      "docs/kb/index.md": "---\nokf_version: 1\n---\n",
      "tmp/kb-baseline/index.md": "---\nokf_version: 1\n---\n",
      "tmp/kb-baseline/a.md": "a\n"
    }},
    "expected": {
      "bundles": [{"root": "docs/kb", "index": "docs/kb/index.md", "files": ["docs/kb/index.md"]}],
      "ignored": [], "ignoredBundles": []
    },
    "note": "Rule 1: OKF_DEFAULT_EXCLUDE tmp/** matches the folder tmp itself, so the walk never enters it and the junk copy tmp/kb-baseline is no bundle. A bundle of only its index.md still lists it."
  },
  {
    "id": "OS-05",
    "kind": "detect",
    "input": {"config": {"okf": {"exclude": ["docs/private/**"]}}, "tree": {
      "docs/kb/index.md": "---\nokf_version: 1\n---\n",
      "docs/private/index.md": "---\nokf_version: 1\n---\n",
      "docs/private/x.md": "x\n",
      "tmp/old/index.md": "---\nokf_version: 1\n---\n"
    }},
    "expected": {
      "bundles": [{"root": "docs/kb", "index": "docs/kb/index.md", "files": ["docs/kb/index.md"]}],
      "ignored": [], "ignoredBundles": []
    },
    "note": "Rule 1/2: docs/private/** (from config) excludes the folder docs/private; the user list does not replace the default, so tmp/** still excludes tmp/old. One bundle left."
  },
  {
    "id": "OS-06",
    "kind": "detect",
    "input": {"tree": {
      "docs/kb/index.md": "---\nokf_version: 1\n---\n- [Private](../../../private_kb/secret.md)\n",
      "../private_kb/index.md": "---\nokf_version: 1\n---\n",
      "../private_kb/secret.md": "secret\n"
    }},
    "expected": {
      "bundles": [{"root": "docs/kb", "index": "docs/kb/index.md", "files": ["docs/kb/index.md"]}],
      "ignored": [], "ignoredBundles": []
    },
    "note": "Rule 4: the link in the index points to <tmp>/private_kb, outside the project root; links are never followed and the walk stays inside the root, so the private bundle is not found."
  },
  {
    "id": "OS-07",
    "kind": "detect",
    "input": {"tree": {
      "a/index.md": "# A\n\n---\nokf_version: 1\n---\n",
      "b/index.md": "---\ntitle: B\n---\nokf_version: 1\n",
      "c/index.md": "﻿---\r\nokf_version: 2\r\n---\r\n",
      "d/index.md": "---\ndescription: \nokf_version: 1\n---\n",
      "node_modules/pkg/index.md": "---\nokf_version: 1\n---\n"
    }},
    "expected": {
      "bundles": [
        {"root": "c", "index": "c/index.md", "files": ["c/index.md"]},
        {"root": "d", "index": "d/index.md", "files": ["d/index.md"]}
      ],
      "ignored": [], "ignoredBundles": []
    },
    "note": "Rule 3: a does not start with ---; in b okf_version comes after the closing ---; d's 516-character description line puts okf_version at byte 521, inside the first 8192 bytes (hook 3.1.0; before it, the 512-byte window missed d); c starts with a BOM and uses CRLF, both accepted -> c and d. Rule 1: node_modules is never entered."
  },
  {
    "id": "OS-08",
    "kind": "detect",
    "input": {"tree": {
      ".gitignore": "docs/kb/private.md\ndocs/kb-local/\n",
      "docs/kb/index.md": "---\nokf_version: 1\n---\n",
      "docs/kb/private.md": "p\n",
      "docs/kb-local/index.md": "---\nokf_version: 1\n---\n",
      "docs/kb-local/me.md": "m\n"
    }},
    "expected": {
      "bundles": [
        {"root": "docs/kb", "index": "docs/kb/index.md", "files": ["docs/kb/index.md", "docs/kb/private.md"]},
        {"root": "docs/kb-local", "index": "docs/kb-local/index.md", "files": ["docs/kb-local/index.md", "docs/kb-local/me.md"]}
      ],
      "ignored": ["docs/kb/private.md", "docs/kb-local/index.md", "docs/kb-local/me.md"],
      "ignoredBundles": ["docs/kb-local"]
    },
    "note": "Rule 7: git check-ignore lists private.md and both kb-local files (exit 0). Ignored files stay in the snapshot, flagged. docs/kb-local's index.md is ignored, so the bundle is ignored; docs/kb's index is not."
  },
  {
    "id": "OS-09",
    "kind": "detect",
    "input": {"git": false, "tree": {
      "docs/kb/index.md": "---\nokf_version: 1\n---\n",
      "docs/kb/a.md": "a\n"
    }},
    "expected": {
      "bundles": [{"root": "docs/kb", "index": "docs/kb/index.md", "files": ["docs/kb/a.md", "docs/kb/index.md"]}],
      "ignored": ["docs/kb/a.md", "docs/kb/index.md"],
      "ignoredBundles": ["docs/kb"]
    },
    "note": "Rule 7: outside a git repository check-ignore fails (exit 128, neither 0 nor 1) -> fail closed: every file and the bundle are ignored."
  },
  {
    "id": "OS-10",
    "kind": "detect",
    "input": {"tree": {"README.md": "# no kb\n", "docs/index.md": "# Docs\n"}},
    "expected": {"bundles": [], "ignored": [], "ignoredBundles": []},
    "note": "Rule 3: docs/index.md has no front matter -> no bundle. Rule 10: the snapshot is still built, with bundles []."
  },
  {
    "id": "OS-11",
    "kind": "compare",
    "input": {
      "before": {"tree": {"docs/kb/index.md": "---\nokf_version: 1\n---\n", "docs/kb/a.md": "a\n"}, "mtimeOverride": {"docs/kb/a.md": 1577836800000}},
      "after": {"tree": {"docs/kb/index.md": "---\nokf_version: 1\n---\n", "docs/kb/a.md": "a\n"}, "mtimeOverride": {"docs/kb/a.md": 1735689600000}}
    },
    "expected": {"sameId": true},
    "note": "Rule 9: same paths, sizes, hashes and flags; the mtime (2020 vs 2025) is not in the canon -> same id."
  },
  {
    "id": "OS-12",
    "kind": "compare",
    "input": {
      "before": {"tree": {"docs/kb/index.md": "---\nokf_version: 1\n---\n", "docs/kb/a.md": "a\n"}, "mtimeOverride": {"docs/kb/a.md": 1577836800000}},
      "after": {"tree": {"docs/kb/index.md": "---\nokf_version: 1\n---\n", "docs/kb/a.md": "b\n"}, "mtimeOverride": {"docs/kb/a.md": 1577836800000}}
    },
    "expected": {"sameId": false},
    "note": "Rule 8/9: a.md has the same size (2) and the same forced mtime, but the content differs -> different hash -> different id."
  },
  {
    "id": "OS-13",
    "kind": "compare",
    "input": {
      "before": {"tree": {".gitignore": "", "docs/kb/index.md": "---\nokf_version: 1\n---\n", "docs/kb/a.md": "a\n"}},
      "after": {"tree": {".gitignore": "docs/kb/a.md\n", "docs/kb/index.md": "---\nokf_version: 1\n---\n", "docs/kb/a.md": "a\n"}}
    },
    "expected": {"sameId": false},
    "note": "Rule 7/9: identical KB content, but a.md becomes ignored; ignored is part of the canon -> different id (so the server learns the new privacy flag)."
  },
  {
    "id": "OS-14",
    "kind": "order",
    "input": {"bundles": [
      {"root": "docs/kb", "index": "docs/kb/index.md", "ignored": false, "files": [
        {"path": "docs/kb/index.md", "ignored": false, "size": 20, "hash": "1111111111111111111111111111111111111111111111111111111111111111"},
        {"path": "docs/kb/a.md", "ignored": false, "size": 2, "hash": "2222222222222222222222222222222222222222222222222222222222222222", "mtimeMs": 1577836800000}
      ]},
      {"root": "notes", "index": "notes/index.md", "ignored": true, "files": [
        {"path": "notes/index.md", "ignored": true, "size": 20, "hash": "3333333333333333333333333333333333333333333333333333333333333333"}
      ]}
    ]},
    "expected": {"sameId": true, "id": "3dac7b3dc5d79f55e1c512dae5f76fcb4f472fa28ed6b9240d8ccbdc41748b91"},
    "note": "Rule 9: both orders sort to docs/kb then notes, files a.md then index.md, and the extra mtimeMs field is projected away -> same canon -> same id. The id is sha256 of the canon JSON [{\"root\":\"docs/kb\",\"index\":\"docs/kb/index.md\",\"ignored\":false,\"files\":[{\"path\":\"docs/kb/a.md\",\"ignored\":false,\"size\":2,\"hash\":\"22…22\"},{\"path\":\"docs/kb/index.md\",…}]},{\"root\":\"notes\",…}] (hashes abbreviated here)."
  },
  {"id":"OS-15","kind":"detect","input":{"tree":{"kb/index.md":"---\ndescription: \nokf_version: 0.3\n---\n# KB\n"}},"expected":{"bundles":[{"root":"kb","index":"kb/index.md","files":["kb/index.md"]}],"ignored":[],"ignoredBundles":[],"bundleFields":{"kb":{"okfVersion":"0.3","description":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}},"fileMeta":{"kb/index.md":{"frontMatter":true,"hasGenerated":false,"hasTimestamp":false,"type":null}}},"note":"Rule 3: a 1 024-character description line puts okf_version at byte 1 042 (4 + 13 + 1 024 + 1), inside the 8 192-byte window -> detected (missed by the 512-byte window before hook 3.1.0). Rule 3a: description is cut to OKF_META_VALUE_MAX_CHARS = 200; okf_version 0.3; no title key -> no title field. Rule 3b: the index gets meta too: closed front matter, no generated/timestamp, no type."},
  {"id":"OS-16","kind":"detect","input":{"tree":{"kb/index.md":"---\ndescription: \nokf_version: 0.3\n---\n","kb/a.md":"a\n"}},"expected":{"bundles":[],"ignored":[],"ignoredBundles":[]},"note":"Rule 3: the description line alone is 8 214 bytes with its newline, so the okf_version line starts at byte 8 218, past 8 192, and the window ends inside the front matter without it -> no bundle; a.md is under no root and dropped."},
  {"id":"OS-17","kind":"detect","input":{"tree":{"v0/index.md":"---\nokf_version:\ntitle: No value\n---\n","v1/index.md":"---\nokf_version: 0.1\n---\n","v2/index.md":"---\nokf_version: \"0.2\"\n---\n","v3/index.md":"---\nokf_version: 0.3\ntitle: KB three\ndescription: 'Three # not a comment'\n---\n","vm/index.md":"---\nokf_version: 0.3\ntitle: \"unterminated\n  - [ broken\n---\n","vn/index.md":"---\nokf_version: 1\n---\n","vu/index.md":"---\nokf_version: next # unknown\n---\n"}},"expected":{"bundles":[{"root":"v0","index":"v0/index.md","files":["v0/index.md"]},{"root":"v1","index":"v1/index.md","files":["v1/index.md"]},{"root":"v2","index":"v2/index.md","files":["v2/index.md"]},{"root":"v3","index":"v3/index.md","files":["v3/index.md"]},{"root":"vm","index":"vm/index.md","files":["vm/index.md"]},{"root":"vn","index":"vn/index.md","files":["vn/index.md"]},{"root":"vu","index":"vu/index.md","files":["vu/index.md"]}],"ignored":[],"ignoredBundles":[],"bundleFields":{"v0":{"title":"No value"},"v1":{"okfVersion":"0.1"},"v2":{"okfVersion":"0.2"},"v3":{"okfVersion":"0.3","title":"KB three","description":"Three # not a comment"},"vm":{"okfVersion":"0.3"},"vn":{"okfVersion":"1"},"vu":{"okfVersion":"next"}}},"note":"Rule 3: detection only needs the okf_version key, whatever its value -> all seven are bundles. Rule 3a: v0 has an empty value -> no okfVersion field; v2 is double-quoted -> inner 0.2; v3 single-quoted description keeps its # (no comment cut inside quotes); vm (malformed YAML): a \" with no closing quote is not a scalar -> no title, the indented line is not a top-level key; vn numeric 1 kept as text; vu cut at the whitespace-preceded # -> next."},
  {"id":"OS-18","kind":"detect","input":{"tree":{"kb/index.md":"---\nokf_version: 0.3\ntitle: KB\n---\n","kb/a.md":"---\ntype: Guide\nstatus: Deprecated\nsuperseded_by: ../b.md\nstale_after: 2026-01-01\ngenerated: { by: x, at: 2026-01-01T00:00:00Z }\n---\n# A\n","kb/b.md":"# B without front matter\n","kb/c.md":"---\ntitle: C\ntimestamp: 2025-01-01\n---\n","kb/d.md":"---\ntype: Note\nno closing line\n"}},"expected":{"bundles":[{"root":"kb","index":"kb/index.md","files":["kb/a.md","kb/b.md","kb/c.md","kb/d.md","kb/index.md"]}],"ignored":[],"ignoredBundles":[],"bundleFields":{"kb":{"okfVersion":"0.3","title":"KB"}},"fileMeta":{"kb/a.md":{"frontMatter":true,"hasGenerated":true,"hasTimestamp":false,"type":"Guide","status":"Deprecated","superseded_by":"../b.md","stale_after":"2026-01-01"},"kb/b.md":{"frontMatter":false,"hasGenerated":false,"hasTimestamp":false,"type":null},"kb/c.md":{"frontMatter":true,"hasGenerated":false,"hasTimestamp":true,"type":null,"title":null},"kb/d.md":{"frontMatter":false,"hasGenerated":false,"hasTimestamp":false,"type":null},"kb/index.md":{"frontMatter":true,"type":null,"title":null}}},"note":"Rule 3b: a.md carries all four scalar keys as written (status case kept, superseded_by not resolved by the hook) and generated -> hasGenerated; b.md has no front matter -> three false booleans only; c.md has timestamp but no generated, and title is a bundle-only key, never in file meta; d.md never closes its block -> all false, its type ignored; the index has front matter and no type."},
  {"id":"OS-19","kind":"meta","input":{"head":"---\ntitle: \"Hello # world\"  # trailing comment\nstatus: deprecated # old\ntype: 'Guide'\n---\n"},"expected":{"frontMatter":true,"hasGenerated":false,"hasTimestamp":false,"fields":{"title":"Hello # world","status":"deprecated","type":"Guide"}},"note":"Rule 3a: a double-quoted value is the text up to the matching quote (the # inside stays, the rest of the line is dropped); unquoted status is cut at the whitespace-preceded #; single quotes stripped."},
  {"id":"OS-20","kind":"meta","input":{"head":"---\ntype:\nstatus: null\nstale_after: ~\ndescription: >-\n  folded text\ntitle: |\n  literal\nsuperseded_by: \"\"\nokf_version: 0.3\n---\n"},"expected":{"frontMatter":true,"fields":{"okf_version":"0.3"}},"note":"Rule 3a: empty, null, ~, the block-scalar markers >- and |, and an empty quoted string all mean \"no value\" -> absent; the indented continuation lines are not top-level keys. Only okf_version remains."},
  {"id":"OS-21","kind":"meta","input":{"head":"---\ntitle: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n---\n"},"expected":{"frontMatter":true,"fields":{"title":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}},"note":"Rule 3a: a 250-character value is cut to OKF_META_VALUE_MAX_CHARS = 200."},
  {"id":"OS-22","kind":"meta","input":{"head":"---\ntype: Guide\ngenerated: { by: x, at: y }\n"},"expected":{"frontMatter":false,"hasGenerated":false,"hasTimestamp":false,"fields":{}},"note":"Rule 3a: no closing --- inside the head -> unclosed block, everything ignored (all false, no fields)."},
  {"id":"OS-23","kind":"meta","input":{"head":"﻿---\r\ntype: Guide\r\ntimestamp: 2025-01-01\r\n---\r\n# Body\r\n"},"expected":{"frontMatter":true,"hasGenerated":false,"hasTimestamp":true,"fields":{"type":"Guide"}},"note":"Rule 3a: the BOM is dropped and \\r stripped, so the block parses; timestamp sets hasTimestamp and is not a kept scalar."},
  {"id":"OS-24","kind":"meta","input":{"head":"---\ngenerated: { by: \"human:x\", at: \"2026-11-20T00:00:00Z\" }\ntimestamp: 2025-01-01\ntype: Guide\ntype: Other\ntags: [a, b]\n---\n"},"expected":{"frontMatter":true,"hasGenerated":true,"hasTimestamp":true,"fields":{"type":"Guide"}},"note":"Rule 3a: generated and timestamp set their booleans; the first type wins; tags is not on the whitelist."},
  {"id":"OS-25","kind":"meta","input":{"head":"---\nmeta:\n  type: Nested\n  generated: yes\n  status: deprecated\n---\n"},"expected":{"frontMatter":true,"hasGenerated":false,"hasTimestamp":false,"fields":{}},"note":"Rule 3a: indented keys are not top-level -> neither type, status nor generated count; meta itself is not whitelisted."},
  {"id":"OS-26","kind":"meta","input":{"head":"# Title\n\n---\ntype: Guide\n---\n"},"expected":{"frontMatter":false,"hasGenerated":false,"hasTimestamp":false,"fields":{}},"note":"Rule 3a: line 0 is not --- -> no front matter."},
  {"id":"OS-27","kind":"id","input":{"bundles":[{"root":"kb","index":"kb/index.md","ignored":false,"files":[{"path":"kb/a.md","ignored":false,"size":10,"hash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},{"path":"kb/index.md","ignored":false,"size":5,"hash":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]}]},"expected":{"id":"5dd2eb05119fa5d223052331bb88d627516e30cb9acc820f211e92c53a554860"},"note":"Rule 9: a bundle without okfVersion/title/description and files without meta canonicalise exactly as before hook 3.1.0 -> the id computed by the 3.0.0 code on 2026-11-20 (DD-H4), so an upgrade does not resend unchanged KBs."},
  {"id":"OS-28","kind":"id","input":{"bundles":[{"root":"kb","index":"kb/index.md","ignored":false,"files":[{"path":"kb/a.md","ignored":false,"size":10,"hash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},{"path":"kb/index.md","ignored":false,"size":5,"hash":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}],"title":"KB"}]},"expected":{"differsFrom":"5dd2eb05119fa5d223052331bb88d627516e30cb9acc820f211e92c53a554860"},"note":"Rule 9: title is appended to the bundle canon when it is a string -> different canon -> different id."},
  {"id":"OS-29","kind":"id","input":{"bundles":[{"root":"kb","index":"kb/index.md","ignored":false,"files":[{"path":"kb/a.md","ignored":false,"size":10,"hash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","meta":{"frontMatter":true,"hasGenerated":true,"hasTimestamp":false,"type":"Guide","status":"deprecated"}},{"path":"kb/index.md","ignored":false,"size":5,"hash":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]}]},"expected":{"id":"3fb148e87e5b08caf87db8ff821228e52d3b722b2d4efc859a5e7f473f01e578","differsFrom":"5dd2eb05119fa5d223052331bb88d627516e30cb9acc820f211e92c53a554860"},"note":"Rule 9: kb/a.md carries meta -> {path, ignored, size, hash, meta} with meta projected in the order frontMatter, hasGenerated, hasTimestamp, type, status, superseded_by, stale_after -> differs from the legacy id."},
  {"id":"OS-30","kind":"id","input":{"bundles":[{"root":"kb","index":"kb/index.md","ignored":false,"files":[{"path":"kb/a.md","ignored":false,"size":10,"hash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","meta":{"status":"deprecated","type":"Guide","hasTimestamp":false,"extra":"x","hasGenerated":true,"frontMatter":true}},{"path":"kb/index.md","ignored":false,"size":5,"hash":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]}]},"expected":{"id":"3fb148e87e5b08caf87db8ff821228e52d3b722b2d4efc859a5e7f473f01e578"},"note":"Rule 9: the same meta written in another key order plus an unknown key extra -> the projection drops extra and fixes the order -> the same canon and the same id as OS-29."},
  {"id":"OS-31","kind":"meta","input":{"head":"---\ntitle: [unclosed flow\ndescription: {a: 1}\ntype: 'Guide\nstatus: \"deprecated\nsuperseded_by: [x](./b.md)\nstale_after: 2026-01-01\n---\n"},"expected":{"frontMatter":true,"fields":{"stale_after":"2026-01-01"}},"note":"Rule 3a: an unquoted value starting with [ or { (flow sequence / mapping, broken or not) and a quote that never closes are not scalars -> absent, never shown as raw text; the plain stale_after stays."}
]
