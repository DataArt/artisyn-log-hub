  },
  {
    "id": "CR-03",
    "input": {"kind": "ratio", "read": 0, "write": 500},
    "expected": {"ratio": 0},
    "note": "Rule 1: denominator 500 > 0, 0 / 500 = 0 (a real 0, all writes)."
  },
  {
    "id": "CR-04",
    "input": {"kind": "ratio", "read": 500, "write": 0},
    "expected": {"ratio": 1},
    "note": "Rule 1: 500 / 500 = 1."
