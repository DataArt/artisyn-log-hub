[
  {"id": "US-01", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 100, "v2": null, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": true, "adopt": true}, "note": "no v2 entry, old size equals stat size -> skip and adopt (rule 3)"},
  {"id": "US-02", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 90, "v2": null, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": false, "adopt": false}, "note": "no v2 entry, file grew -> send (rule 5)"},
  {"id": "US-03", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": null, "v2": null, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": false, "adopt": false}, "note": "never uploaded -> send (rule 2)"},
  {"id": "US-04", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 100, "v2": {"size": 100, "mtimeMs": 1800000000000, "paramsSha256": "p1"}, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": true, "adopt": false}, "note": "all equal -> skip, nothing to adopt (rule 4)"},
  {"id": "US-05", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 100, "v2": {"size": 100, "mtimeMs": 1800000000000, "paramsSha256": "p1"}, "statSize": 100, "statMtimeMs": 1800000005000, "paramsSha256": "p1"}, "expected": {"skip": false, "adopt": false}, "note": "same size but a newer mtime (same-length rewrite) -> send (rule 4b)"},
  {"id": "US-06", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 100, "v2": {"size": 100, "mtimeMs": 1800000000000, "paramsSha256": "p1"}, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p2"}, "expected": {"skip": false, "adopt": false}, "note": "params changed (late .meta.json gave a description) -> send (rule 4c)"},
  {"id": "US-07", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 100, "v2": {"size": 120, "mtimeMs": 1800000000000, "paramsSha256": "p1"}, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": false, "adopt": false}, "note": "old manifest and v2 disagree on size (an old hook wrote the old one since) -> send (rule 4a)"},
  {"id": "US-08", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 120, "v2": {"size": 120, "mtimeMs": 1800000000000, "paramsSha256": "p1"}, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": false, "adopt": false}, "note": "both manifests agree but the file shrank -> send (rule 4a)"},
  {"id": "US-09", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": null, "v2": {"size": 100, "mtimeMs": 1800000000000, "paramsSha256": "p1"}, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": false, "adopt": false}, "note": "v2 entry without an old one (old manifest deleted) -> send (rule 2)"},
  {"id": "US-10", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 340, "v2": {"size": 340, "mtimeMs": 0, "paramsSha256": "p1", "fp": "aaa"}, "statSize": 340, "statMtimeMs": 0, "paramsSha256": "p1", "fp": "aaa"}, "expected": {"skip": true, "adopt": false}, "note": "tool-calls: summed size and fingerprint equal, mtime 0 on both sides -> skip (rule 4)"},
  {"id": "US-11", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 340, "v2": {"size": 340, "mtimeMs": 0, "paramsSha256": "p1", "fp": "aaa"}, "statSize": 340, "statMtimeMs": 0, "paramsSha256": "p1", "fp": "bbb"}, "expected": {"skip": false, "adopt": false}, "note": "tool-calls: same summed size, a source file rewritten -> fp differs -> send (rule 4d)"},
  {"id": "US-12", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 340, "v2": {"size": 340, "mtimeMs": 0, "paramsSha256": "p1"}, "statSize": 340, "statMtimeMs": 0, "paramsSha256": "p1", "fp": "aaa"}, "expected": {"skip": false, "adopt": false}, "note": "tool-calls: v2 entry has no fp but one is given -> differs -> send (rule 4d)"},
  {"id": "US-13", "input": {"kind": "skip", "isCurrentArtisyn": false, "oldSize": 340, "v2": null, "statSize": 340, "statMtimeMs": 0, "paramsSha256": "p1", "fp": "aaa"}, "expected": {"skip": true, "adopt": true}, "note": "tool-calls: first run of the new hook, old manifest matches -> skip and adopt with the current fp (rule 3)"},
  {"id": "US-14", "input": {"kind": "skip", "isCurrentArtisyn": true, "oldSize": 100, "v2": {"size": 100, "mtimeMs": 1800000000000, "paramsSha256": "p1"}, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": false, "adopt": false}, "note": "the current session's artisyn file is always sent, even when everything matches (rule 1)"},
  {"id": "US-15", "input": {"kind": "skip", "isCurrentArtisyn": true, "oldSize": 100, "v2": null, "statSize": 100, "statMtimeMs": 1800000000000, "paramsSha256": "p1"}, "expected": {"skip": false, "adopt": false}, "note": "current artisyn is never adopted either (rule 1)"},
  {"id": "US-16", "input": {"kind": "resume", "entry": {"sha256": "abc", "totalSize": 6291456, "totalChunks": 7, "nextChunkIndex": 3}, "totalSize": 6291456, "sha256": "abc"}, "expected": {"resume": true}, "note": "same body hash and size, chunks left -> resume (rule 6)"},
  {"id": "US-17", "input": {"kind": "resume", "entry": {"sha256": "abc", "totalSize": 6291456, "totalChunks": 7, "nextChunkIndex": 3}, "totalSize": 6291456, "sha256": "def"}, "expected": {"resume": false}, "note": "same size but the body changed -> restart (rule 6)"},
  {"id": "US-18", "input": {"kind": "resume", "entry": {"totalSize": 6291456, "totalChunks": 7, "nextChunkIndex": 3}, "totalSize": 6291456, "sha256": "abc"}, "expected": {"resume": false}, "note": "legacy pending entry without sha256 -> restart (rule 6)"},
  {"id": "US-19", "input": {"kind": "resume", "entry": {"sha256": "abc", "totalSize": 6291456, "totalChunks": 7, "nextChunkIndex": 3}, "totalSize": 6291500, "sha256": "abc"}, "expected": {"resume": false}, "note": "total size differs -> restart (rule 6)"},
  {"id": "US-20", "input": {"kind": "resume", "entry": {"sha256": "abc", "totalSize": 6291456, "totalChunks": 7, "nextChunkIndex": 7}, "totalSize": 6291456, "sha256": "abc"}, "expected": {"resume": false}, "note": "no chunk left -> restart (rule 6)"},
  {"id": "US-21", "input": {"kind": "resume", "entry": null, "totalSize": 6291456, "sha256": "abc"}, "expected": {"resume": false}, "note": "no pending entry -> fresh upload (rule 6)"},
  {"id": "US-22", "input": {"kind": "params", "params": {"type": "claude", "sessionId": "s1"}, "other": {"type": "claude", "sessionId": "s1", "parentSessionId": "", "workflowRunId": null, "agentDescription": "", "workflowPhase": ""}}, "expected": {"equal": true}, "note": "absent, null and empty params hash the same (rule 7)"},
  {"id": "US-23", "input": {"kind": "params", "params": {"type": "claude-subagent", "sessionId": "agent-a1", "parentSessionId": "s1"}, "other": {"type": "claude-subagent", "sessionId": "agent-a1", "parentSessionId": "s1", "agentDescription": "Explore the repo"}}, "expected": {"equal": false}, "note": "a late .meta.json adds agentDescription -> hash changes (rule 7)"},
  {"id": "US-24", "input": {"kind": "params", "params": {"type": "claude-subagent", "sessionId": "a", "workflowRunId": "b"}, "other": {"type": "claude-subagent", "sessionId": "a", "parentSessionId": "b"}}, "expected": {"equal": false}, "note": "values are positional: the same value in another field hashes differently (rule 7)"}
]
