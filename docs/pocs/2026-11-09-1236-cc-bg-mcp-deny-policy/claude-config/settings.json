{
  "permissions": {
    "denyInsteadOfPrompting": true,
    "allow": [
      "mcp__poc__slow_echo"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${POC_DIR}/hook-log.cjs\"",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${POC_DIR}/hook-log.cjs\"",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${POC_DIR}/hook-log.cjs\"",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${POC_DIR}/hook-log.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
