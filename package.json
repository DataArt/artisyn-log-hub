{
  "name": "artisyn-log-hub",
  "version": "1.0.0",
  "description": "Self-hosted server and web viewer for Claude Code session telemetry, plus the hook and installer that collect it",
  "author": "Denis Tsyplakov",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "build:clean": "node scripts/clean-dist.js",
    "install:hooks-installer": "cd artisyn-hooks-installer && npm install",
    "build:hooks-installer": "node scripts/build-hooks-installer.js",
    "build:client": "cd client && bun run build",
    "build:server": "ncc build server/src/main.ts -o dist",
    "build:copy:client": "copyfiles -u 2 \"client/dist/**/*\" dist/public",
    "build:copy:static": "copyfiles -u 2 \"server/src/public/**/*\" dist/public",
    "build:copy:env": "node -e \"require('fs').copyFileSync('.env.defaults', 'dist/.env')\"",
    "build:postclean": "node -e \"['src','test','drizzle.config.d.ts'].forEach(p=>{try{require('fs').rmSync('dist/'+p,{recursive:true,force:true})}catch(_){}})\"",
    "build:copy:native": "node scripts/copy-native.js",
    "build:copy:migrations": "copyfiles -u 3 \"server/drizzle/migrations/**/*\" dist/drizzle/migrations",
    "build:assets": "node scripts/build-assets.js",
    "build": "node scripts/build.js",
    "build:serial": "npm run build:clean && npm run install:hooks-installer && npm run build:hooks-installer && npm run build:client && npm run build:server && npm run build:copy:client && npm run build:copy:static && npm run build:copy:env && npm run build:copy:native && npm run build:copy:migrations && npm run build:postclean",
    "build:perf": "tsc --project server/perf-tests/tsconfig.json",
    "perf": "npm run build:perf && node server/perf-tests/dist/run.js",
    "test:scripts": "node --test scripts/__tests__/*.test.js client/scripts/__tests__/*.test.cjs",
    "test:scenarios": "node scripts/scenarios/run.mjs",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "corpus:generate": "node scripts/corpus/generate.mjs",
    "corpus:bootstrap": "node scripts/corpus/bootstrap.js",
    "test:e2e": "playwright test --project=core",
    "test:e2e:full": "playwright test --project=extended",
    "local-release-bundle": "node scripts/local-release-bundle.js",
    "local-loghub:install": "node scripts/local-loghub.js install",
    "local-loghub:update": "node scripts/local-loghub.js update"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.3",
    "@vercel/ncc": "^0.38.3",
    "c8": "^12.0.0",
    "copyfiles": "^2.4.1",
    "pg": "^8.22.0",
    "typescript": "^6.0.3"
  }
}
